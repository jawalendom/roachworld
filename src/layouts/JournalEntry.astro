---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from './Layout.astro';
import MagazineView from '../components/MagazineView.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'journal'>['data'];
const { title, dek, kicker, issue, pubDate, updatedDate, byline, heroImage, tags } = Astro.props;
---

<Layout title={title} description={dek} image={heroImage} wide>
	<article class="entry">
		<MagazineView kicker={kicker} title={title} dek={dek} byline={byline}>
			<header slot="header" class="entry-head">
				<p class="kicker">
					{kicker} · No. {String(issue).padStart(2, '0')}
				</p>
				<h1>{title}</h1>
				<p class="dek">{dek}</p>
				<p class="byline">
					By {byline} · <FormattedDate date={pubDate} />
					{updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
				</p>
				{
					heroImage && (
						<figure class="hero">
							<Image src={heroImage} alt="" width={1200} height={720} />
						</figure>
					)
				}
			</header>

			<slot />
		</MagazineView>

		{
			tags.length > 0 && (
				<ul class="tags">
					{tags.map((t) => (
						<li>#{t}</li>
					))}
				</ul>
			)
		}
	</article>

	<style>
		.entry {
			margin-top: 1rem;
		}
		.entry-head {
			max-width: var(--measure);
		}
		.entry-head h1 {
			font-size: clamp(2.4rem, 7vw, 4.6rem);
			margin: 0.2em 0 0.3em;
		}
		.entry-head .dek {
			font-family: var(--font-display);
			font-weight: 600;
			font-size: clamp(1.1rem, 2.6vw, 1.6rem);
			line-height: 1.3;
			margin: 0 0 1rem;
		}
		.entry-head .byline {
			font-family: var(--font-mono);
			font-size: 0.78rem;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			margin: 0;
		}
		.entry-head .hero {
			margin: 1.6rem 0 0;
		}
		.entry-head .hero :global(img) {
			width: 100%;
			height: auto;
			border: 3px solid var(--ink);
			box-shadow: 8px 8px 0 var(--pink);
			filter: grayscale(1) contrast(1.15);
		}
		.tags {
			list-style: none;
			padding: 0;
			margin: 3rem 0 0;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
			font-family: var(--font-mono);
			font-size: 0.78rem;
			text-transform: uppercase;
			letter-spacing: 0.08em;
		}
		.tags li {
			border: 2px solid var(--blue);
			color: var(--blue);
			padding: 0.2em 0.6em;
		}
	</style>
</Layout>
