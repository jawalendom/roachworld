---
import { Image } from 'astro:assets';
import Edition from '../layouts/Edition.astro';
import EditionPage from '../components/EditionPage.astro';
import { SITE_TITLE, EDITOR } from '../consts';
import portrait from '../assets/about-jordan.jpg';
---

<Edition title="About" description={`About ${SITE_TITLE}, a digital zine by ${EDITOR}.`} current="about">
	<EditionPage kicker="About" title={SITE_TITLE}>
		<figure class="portrait">
			<Image src={portrait} alt={EDITOR} width={1200} />
			<figcaption>// {EDITOR} / 8theroach</figcaption>
		</figure>
		<p>
			<strong>{SITE_TITLE}</strong> is a digital zine created by me. It is a spot where I can
			highlight friends, family, and collaborators. It is a landing page for my memories and an
			exercise in artistic expression. It’s your window into my personal museum.
		</p>
		<p>You may ask yourself, “Well, why the fuck should I care?”</p>
		<p class="end">END</p>
	</EditionPage>
</Edition>

<style>
	.portrait {
		margin: 0 0 2.2rem;
	}
	.portrait :global(img) {
		display: block;
		width: 100%;
		height: auto;
		outline: 1px solid rgba(0, 255, 156, 0.5);
		outline-offset: 6px;
	}
	figcaption {
		margin-top: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: #ff2e4d;
	}
	p {
		margin: 0 0 1.2em;
	}
	strong {
		font-family: var(--font-display);
		font-weight: 800;
		letter-spacing: 0.02em;
	}
	.end {
		margin-top: 2.4em;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.3em;
		color: #00ff9c;
	}
</style>
