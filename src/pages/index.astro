---
import Edition from '../layouts/Edition.astro';
import Layout from '../layouts/Layout.astro';
import IssueScroll from '../components/IssueScroll.astro';
import EditionToggle from '../components/EditionToggle.astro';
import { getIssues } from '../lib/issues';
import { editorFor } from '../lib/editors';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issues = await getIssues();
const latest = issues[0];
const older = issues.length - 1;
const Editor = latest ? editorFor(latest.dir) : null;
const editorHref = latest ? `${base}/issues/${latest.dir}/` : base;
const plainHref = latest ? `${base}/issues/${latest.dir}/plain/` : base;
---

{
	latest && Editor ? (
		<Edition title={SITE_TITLE} description={SITE_DESCRIPTION} issue={latest} current="latest">
			<Editor issue={latest} />
			<EditionToggle editorHref={editorHref} plainHref={plainHref} current="editor" />
		</Edition>
	) : (
		<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
			{latest ? (
				<>
					<IssueScroll issue={latest} label="The latest issue" />
					{older > 0 && (
						<p class="more">
							<a href={`${base}/archive/`}>
								{older} older issue{older === 1 ? '' : 's'} in the archive →
							</a>
						</p>
					)}
				</>
			) : (
				<p>No issues yet.</p>
			)}
			<EditionToggle
				editorHref={editorHref}
				plainHref={plainHref}
				current="plain"
				hasEditor={!!Editor}
			/>
		</Layout>
	)
}

<style>
	.more {
		margin: 3rem 0 0;
		padding-top: 1.5rem;
		border-top: 3px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
</style>
