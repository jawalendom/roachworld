---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import IssueScroll from '../components/IssueScroll.astro';
import { getIssues } from '../lib/issues';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issues = await getIssues();
const latest = issues[0];
const older = issues.length - 1;
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<Masthead text="ROACHWORLD" subtitle="A digital magazine" />

	{
		latest ? (
			<>
				<IssueScroll issue={latest} label="The latest issue" />
				{older > 0 && (
					<p class="more">
						<a href={`${base}/archive/`}>
							{older} older issue{older === 1 ? '' : 's'} in the archive →
						</a>
					</p>
				)}
			</>
		) : (
			<p class="empty">No issues yet.</p>
		)
	}
</Layout>

<style>
	.more {
		margin: 3rem 0 0;
		padding-top: 1.5rem;
		border-top: 3px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}
	.empty {
		font-family: var(--font-mono);
	}
</style>
