---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('journal', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.issue - a.data.issue,
);
---

<Layout title="Archive" description={`Every issue of ${SITE_TITLE}.`}>
	<p class="kicker">The full run</p>
	<h1>Archive</h1>

	<ol class="run">
		{
			entries.map((e) => (
				<li>
					<a href={`${base}/journal/${e.id}/`}>
						<span class="no">No. {String(e.data.issue).padStart(2, '0')}</span>
						<span class="ti">{e.data.title}</span>
						<span class="meta">
							<FormattedDate date={e.data.pubDate} />
							{e.data.tags.length > 0 && <> · {e.data.tags.join(' · ')}</>}
						</span>
						<span class="de">{e.data.dek}</span>
					</a>
				</li>
			))
		}
	</ol>
</Layout>

<style>
	h1 {
		font-size: clamp(2.5rem, 9vw, 5rem);
		margin-bottom: 2rem;
	}
	.run {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.run li {
		border-top: 2px solid var(--hairline);
	}
	.run li:last-child {
		border-bottom: 2px solid var(--hairline);
	}
	.run a {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 0.25rem 1.5rem;
		padding: 1.4rem 0;
		background: none;
	}
	.run a:hover {
		color: inherit;
		background: var(--paper-2);
	}
	.run .no {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--blue);
		padding-top: 0.35rem;
	}
	.run .ti {
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(1.3rem, 3.5vw, 2rem);
		line-height: 1;
	}
	.run .meta {
		grid-column: 2;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--pink);
	}
	.run .de {
		grid-column: 2;
		font-size: 0.95rem;
		opacity: 0.8;
	}
	@media (max-width: 560px) {
		.run a {
			grid-template-columns: 1fr;
		}
		.run .meta,
		.run .de {
			grid-column: 1;
		}
	}
</style>
