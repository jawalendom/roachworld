---
import Layout from '../../layouts/Layout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getIssues } from '../../lib/issues';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issues = await getIssues();
// The latest issue lives on the front page; the archive holds the rest.
const older = issues.slice(1);
---

<Layout title="Archive" description={`Back issues of ${SITE_TITLE}.`}>
	<p class="kicker">Back issues</p>
	<h1>Archive</h1>

	{
		older.length > 0 ? (
			<ol class="run">
				{older.map((iss) => (
					<li>
						<a href={`${base}/issues/${iss.dir}/`}>
							<span class="no">No. {String(iss.data.number).padStart(2, '0')}</span>
							<span class="ti">{iss.data.title}</span>
							<span class="meta">
								<FormattedDate date={iss.data.date} /> · {iss.articles.length} article
								{iss.articles.length === 1 ? '' : 's'}
							</span>
							{iss.data.blurb && <span class="de">{iss.data.blurb}</span>}
							<span class="contents">
								{iss.articles.map((a, i) => (
									<>
										{i > 0 && <span class="sep"> · </span>}
										{a.data.title}
									</>
								))}
							</span>
						</a>
					</li>
				))}
			</ol>
		) : (
			<p class="empty">
				No back issues yet — the latest is on the <a href={base || '/'}>front page</a>.
			</p>
		)
	}
</Layout>

<style>
	h1 {
		font-size: clamp(2.5rem, 9vw, 5rem);
		margin-bottom: 2rem;
	}
	.empty {
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.run {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.run li {
		border-top: 3px solid var(--ink);
	}
	.run li:last-child {
		border-bottom: 3px solid var(--ink);
	}
	.run a {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 0.3rem 1.5rem;
		padding: 1.8rem 0;
		background: none;
	}
	.run a:hover {
		color: inherit;
		background: var(--paper-2);
	}
	.run .no {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--blue);
		padding-top: 0.5rem;
	}
	.run .ti {
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(1.6rem, 4.5vw, 2.6rem);
		line-height: 1;
	}
	.run .meta {
		grid-column: 2;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--blue);
	}
	.run .de {
		grid-column: 2;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.05rem;
		line-height: 1.3;
		margin-top: 0.3rem;
	}
	.run .contents {
		grid-column: 2;
		font-size: 0.9rem;
		opacity: 0.75;
		margin-top: 0.4rem;
	}
	.run .contents .sep {
		color: var(--blue);
	}
	@media (max-width: 560px) {
		.run a {
			grid-template-columns: 1fr;
		}
		.run .meta,
		.run .de,
		.run .contents {
			grid-column: 1;
		}
	}
</style>
