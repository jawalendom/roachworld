---
import Edition from '../../layouts/Edition.astro';
import EditionPage from '../../components/EditionPage.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getIssues } from '../../lib/issues';
import { SITE_TITLE } from '../../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const issues = await getIssues();
// The latest issue lives on the front page; the archive holds the rest.
const older = issues.slice(1);
---

<Edition title="Archive" description={`Back issues of ${SITE_TITLE}.`} current="archive">
	<EditionPage kicker="Back issues" title="Archive">
		{
			older.length > 0 ? (
				<ol class="run">
					{older.map((iss) => (
						<li>
							<a href={`${base}/issues/${iss.dir}/`}>
								<span class="no">Zine {iss.data.number}</span>
								<span class="ti">{iss.data.title}</span>
								<span class="meta">
									<FormattedDate date={iss.data.date} /> // {iss.articles.length} article
									{iss.articles.length === 1 ? '' : 's'}
								</span>
								{iss.data.blurb && <span class="de">{iss.data.blurb}</span>}
								<span class="contents">
									{iss.articles.map((a, i) => (
										<>
											{i > 0 && <span class="sep"> · </span>}
											{a.data.title}
										</>
									))}
								</span>
							</a>
						</li>
					))}
				</ol>
			) : (
				<p class="empty">
					&gt; No back issues yet — the latest is on the <a href={`${base}/`}>front page</a>.
				</p>
			)
		}
	</EditionPage>
</Edition>

<style>
	.empty {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #8a8a90;
	}
	.run {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.run li {
		border-top: 1px solid rgba(230, 230, 233, 0.16);
	}
	.run li:last-child {
		border-bottom: 1px solid rgba(230, 230, 233, 0.16);
	}
	.run a {
		display: grid;
		grid-template-columns: 6rem 1fr;
		gap: 0.3rem 1.5rem;
		padding: 1.8rem 0;
		color: #e6e6e9;
		border: none;
	}
	.run a:hover .ti {
		color: #00ff9c;
	}
	.run .no {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #ff2e4d;
		padding-top: 0.5rem;
	}
	.run .ti {
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(1.6rem, 4.5vw, 2.6rem);
		line-height: 1;
		text-shadow: 0.04em 0 #ff2e4d, -0.04em 0 #13e8ff;
	}
	.run .meta {
		grid-column: 2;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #00ff9c;
	}
	.run .de,
	.run .contents {
		grid-column: 2;
		font-size: 0.9rem;
		color: #8a8a90;
	}
	.run .contents .sep {
		color: #ff2e4d;
	}
	@media (max-width: 560px) {
		.run a {
			grid-template-columns: 1fr;
		}
		.run .meta,
		.run .de,
		.run .contents {
			grid-column: 1;
		}
	}
</style>
