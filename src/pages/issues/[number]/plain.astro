---
// Plain view was retired; this address forwards to the issue's standard view.
import Redirect from '../../../components/Redirect.astro';
import { getIssues } from '../../../lib/issues';

export async function getStaticPaths() {
	const issues = await getIssues();
	return issues.map((issue) => ({ params: { number: issue.dir }, props: { issue } }));
}

const { issue } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Redirect to={`${base}/issues/${issue.dir}/`} />
