---
// Plain view was retired: an article's own address forwards to its standard
// view (the editor sheet), so old and shared links keep working.
import Redirect from '../../../components/Redirect.astro';
import { getIssues, articleSlug } from '../../../lib/issues';

export async function getStaticPaths() {
	const issues = await getIssues();
	return issues.flatMap((issue) =>
		issue.articles.map((article) => ({
			params: { number: issue.dir, slug: articleSlug(article) },
			props: { issue, article },
		})),
	);
}

const { issue, article } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Redirect to={`${base}/issues/${issue.dir}/${articleSlug(article)}/editor/`} />
