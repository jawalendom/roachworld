---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Issue from '../../../components/Issue.astro';
import { getIssues, articleSlug, articleOrder } from '../../../lib/issues';
import { parseBody } from '../../../lib/editor/parseBody';

export async function getStaticPaths() {
	const issues = await getIssues();
	return issues.flatMap((issue) =>
		issue.articles.map((article) => ({
			params: { number: issue.dir, slug: articleSlug(article) },
			props: { issue, article },
		})),
	);
}

const { issue, article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = articleSlug(article);

// Share-card pull quote: explicit frontmatter, else the article's first blockquote.
const shareQuote =
	article.data.shareQuote ??
	parseBody(article.body ?? '').find((b) => b.type === 'pull')?.text ??
	null;
---

<Layout title={article.data.title} description={article.data.dek} image={article.data.heroImage} wide>
	<Issue
		{...article.data}
		issueNumber={issue.data.number}
		order={articleOrder(article)}
		issueHref={`${base}/issues/${issue.dir}/`}
		issueTitle={issue.data.title}
		issueDir={issue.dir}
		slug={slug}
		shareQuote={shareQuote}
	>
		<Content />
	</Issue>
</Layout>
