---
// Editor's view — Issue No. 01, "Erosion".
// Art direction: near-black terminal ground, cold white, acid green + glitch
// red. Machine-drawn — straight rules, registration brackets, RGB channel
// split, decode-style reveals, scanlines. Seeded off the issue title.
import { getImage } from 'astro:assets';
import type { Issue } from '../lib/issues';
import { articleOrder, articleSlug } from '../lib/issues';
import { parseBody } from '../lib/editor/parseBody';

interface Props {
	issue: Issue;
}
const { issue } = Astro.props;

const articles = await Promise.all(
	issue.articles.map(async (a) => {
		const hero = a.data.heroImage
			? await getImage({ src: a.data.heroImage, width: 900, format: 'webp' })
			: null;
		return {
			order: articleOrder(a),
			slug: articleSlug(a),
			kicker: a.data.kicker,
			title: a.data.title,
			dek: a.data.dek,
			byline: a.data.byline,
			heroUrl: hero?.src ?? null,
			blocks: parseBody(a.body ?? ''),
			filler: a.data.filler,
			marginNote: a.data.marginNote ?? null,
		};
	}),
);

const payload = {
	no: issue.data.number,
	title: issue.data.title,
	blurb: issue.data.blurb ?? '',
	date: issue.data.date.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric' }),
	seed: `roachworld-${issue.data.number}-${issue.data.title}`,
	articles,
};
---

<div class="ed-sheet" data-edition-sheet>
	<canvas data-sheet></canvas>
	<div data-sheet-spacer></div>
	<div class="ed-scan" aria-hidden="true"></div>
	<script type="application/json" data-editor-data set:html={JSON.stringify(payload)} />
</div>

<style>
	.ed-sheet {
		position: relative;
	}
	.ed-sheet [data-sheet] {
		position: sticky;
		top: 0;
		display: block;
		width: 100vw;
		height: 100vh;
		margin-left: calc(50% - 50vw);
	}
	.ed-sheet[data-ready] [data-sheet] {
		animation: ed-fade 0.35s steps(3) both;
	}
	@keyframes ed-fade {
		from {
			opacity: 0;
		}
	}
	.ed-scan {
		position: fixed;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background: repeating-linear-gradient(
			to bottom,
			rgba(0, 0, 0, 0) 0,
			rgba(0, 0, 0, 0) 2px,
			rgba(0, 0, 0, 0.24) 3px
		);
		animation: ed-flicker 5s steps(1) infinite;
	}
	@keyframes ed-flicker {
		0%,
		94%,
		100% {
			opacity: 1;
		}
		95% {
			opacity: 0.7;
		}
		96% {
			opacity: 1;
		}
		97% {
			opacity: 0.85;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.ed-sheet[data-ready] [data-sheet],
		.ed-scan {
			animation: none;
		}
	}
</style>

<script>
	import { mountSheet } from '../lib/editor/sheet';
	import { seedFrom } from '../lib/editor/rng';
	import { FONT } from '../lib/pretext/fonts';
	import * as C from '../lib/editor/compose';
	import { rule, crosshair, noiseBlocks } from '../lib/editor/glitch';

	const root = document.querySelector<HTMLElement>('[data-edition-sheet]');
	const dataEl = root?.querySelector<HTMLElement>('[data-editor-data]');
	if (root && dataEl) {
		const data = JSON.parse(dataEl.textContent || '{}');

		const T: C.Theme = {
			ground: '#050506',
			ink: '#e6e6e9',
			dim: '#5f6068',
			accent: '#00ff9c',
			accent2: '#ff2e4d',
			display: FONT.display,
			body: FONT.body,
			mono: FONT.mono,
			hand: FONT.hand,
		};
		const CYAN = '#13e8ff';

		const MARGIN_NOTES = ['flag this', 'signal ↑', 'ref: date', 'attenuating'];

		mountSheet(
			root,
			(s) => {
				// opening scatter — hard fragments, kept to the margins / dead space
				s.push({
					y: s.cursor,
					h: s.vh,
					reveal: s.vh * 0.9,
					latch: false,
					draw(ctx, p) {
						const cols = [T.accent, T.accent2, CYAN, T.dim];
						for (let i = 0; i < 12; i++) {
							const left = s.rng.chance(0.5);
							const gx = left ? s.rng.range(14, 66) : s.rng.range(s.W - 66, s.W - 14);
							const gy = s.rng.chance(0.5)
								? s.rng.range(s.vh * 0.03, s.vh * 0.22)
								: s.rng.range(s.vh * 0.6, s.vh * 0.96);
							const local = Math.max(0, Math.min(1, p * 1.7 - i * 0.05));
							if (local <= 0) continue;
							const col = cols[s.rng.int(0, 3)];
							if (s.rng.chance(0.5)) {
								crosshair(ctx, gx, gy, s.rng.range(6, 14), local, { color: col, width: 1.4, alpha: 0.85 });
							} else {
								rule(ctx, gx, gy, gx + s.rng.range(-26, 26), gy, local, { color: col, width: 2, alpha: 0.7 });
							}
						}
						noiseBlocks(ctx, 0, s.vh * 0.03, s.W, s.vh * 0.2, s.rng, 9, cols, p);
						noiseBlocks(ctx, 0, s.vh * 0.62, s.W, s.vh * 0.34, s.rng, 9, cols, p);
					},
				});

				C.cover(s, T, { no: data.no, title: data.title, date: data.date, blurb: data.blurb });

				s.gap(s.vh * 0.3);
				C.contents(
					s,
					T,
					data.articles.map((a: { order: number; title: string; slug: string }) => ({
						order: a.order,
						title: a.title,
						slug: a.slug,
					})),
				);

				for (const a of data.articles) {
					s.mark(a.slug);
					C.divider(s, T, { order: a.order, kicker: a.filler ? 'Filler' : a.kicker });
					C.headline(s, T, a.title);
					if (a.filler) {
						C.fillerNote(s, T);
					} else {
						C.dek(s, T, a.dek);
						C.byline(s, T, `By ${a.byline}`);
						if (a.heroUrl) C.figure(s, T, { url: a.heroUrl, caption: a.title });
						C.body(s, T, a.blocks);
						if (a.marginNote) C.marginNote(s, T, a.marginNote);
						else if (s.rng.chance(0.6)) C.marginNote(s, T, s.rng.pick(MARGIN_NOTES));
					}
					s.gap(s.vh * 0.12);
				}

				// colophon — end-of-transmission readout
				s.mark('colophon');
				const { x, edge } = C.contentBox(s);
				const cy = s.cursor + s.vh * 0.1;
				s.push({
					y: cy,
					h: 140,
					reveal: 1,
					lead: 0,
					draw(ctx) {
						rule(ctx, edge, 0, s.W - edge, 0, 1, { color: T.accent, width: 2 });
						ctx.save();
						ctx.textBaseline = 'alphabetic';
						(ctx as any).letterSpacing = '2px';
						ctx.font = T.mono(12);
						ctx.fillStyle = T.accent;
						ctx.fillText('> TRANSMISSION COMPLETE', x, 34);
						ctx.fillStyle = T.dim;
						ctx.fillText('  SET WITH PRETEXT // NO BROWSER TEXT LAYOUT', x, 60);
						ctx.fillStyle = T.ink;
						ctx.fillText('  *ALL WORDS 100% HUMAN GENERATED', x, 86);
						ctx.fillStyle = T.dim;
						ctx.fillText('  [ EOF ] █', x, 116);
						(ctx as any).letterSpacing = '0px';
						ctx.restore();
					},
				});
				s.cursor = cy - s.vh * 0.72;
				s.height = s.cursor;
			},
			{ seed: seedFrom(data.seed), ground: T.ground },
		);
	}
</script>
