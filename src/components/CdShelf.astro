---
// The interactive CD shelf. `full` fills the viewport (editor view); otherwise
// it sits inline in an article as a framed panel.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	cds: {
		title: string;
		artist: string;
		spineArtist?: string;
		year?: string;
		color: string;
		tracks: string[];
		cover?: ImageMetadata;
		quote?: string;
		notes?: string;
		clip?: { src: string; start: number; end?: number };
	}[];
	full?: boolean;
	backHref?: string;
	backLabel?: string;
	heading?: string;
	subheading?: string;
}
const { cds, full = false, backHref, backLabel, heading, subheading } = Astro.props;
const data = await Promise.all(
	cds.map(async (cd) => ({
		...cd,
		cover: cd.cover ? (await getImage({ src: cd.cover, width: 1024, format: 'webp' })).src : null,
		clip: cd.clip ? { ...cd.clip, src: import.meta.env.BASE_URL.replace(/\/?$/, '/') + cd.clip.src.replace(/^\//, '') } : undefined,
	})),
);
---

<div class:list={['shelf', { full }]} data-shelf>
	<script type="application/json" data-shelf-data set:html={JSON.stringify(data)} />
	{full && heading && <p class="shelf-head">{heading}</p>}
	{full && subheading && <p class="shelf-sub">{subheading}</p>}
	<div class="shelf-label" data-shelf-label hidden></div>
	<p class="shelf-hint" data-shelf-hint>&gt; loading shelf…</p>
	<aside class="pamphlet" data-pamphlet hidden aria-live="polite">
		<p class="pam-kicker" data-pam-kicker></p>
		<blockquote class="pam-quote" data-pam-quote></blockquote>
		<p class="pam-notes" data-pam-notes></p>
		<button type="button" class="pam-play" data-pam-play hidden></button>
	</aside>
	<button type="button" class="shelf-back" data-shelf-back hidden>[ &lt;- back to shelf ]</button>
	{full && backHref && <a class="shelf-exit" href={backHref}>[ &lt;- {backLabel ?? 'back'} ]</a>}
	<noscript><p class="shelf-hint">The shelf needs JavaScript.</p></noscript>
</div>

<style>
	.shelf {
		position: relative;
		margin: 2rem 0;
		aspect-ratio: 16 / 10;
		min-height: 380px;
		background: #050506;
		color: #e6e6e9;
		border: 1px solid color-mix(in srgb, #00ff9c 35%, transparent);
		overflow: hidden;
		font-family: var(--font-mono);
	}
	.shelf.full {
		position: fixed;
		inset: 0;
		margin: 0;
		aspect-ratio: auto;
		border: 0;
		z-index: 1;
	}
	.shelf::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.22) 3px);
	}
	.shelf.full::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: 70;
		pointer-events: none;
		border-radius: clamp(18px, 4.5vw, 54px) / clamp(16px, 4vw, 46px);
		box-shadow: 0 0 0 200px #000, inset 0 0 clamp(40px, 9vw, 140px) rgba(0, 0, 0, 0.7);
	}
	.shelf-head,
	.shelf-label,
	.shelf-hint,
	.shelf-back,
	.shelf-exit {
		position: absolute;
		z-index: 2;
		margin: 0;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.shelf-head {
		top: clamp(3.4rem, 9vh, 5rem);
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.4rem, 4vw, 2.6rem);
		letter-spacing: 0.02em;
		white-space: nowrap;
		text-shadow: 0.05em 0 #ff2e4d, -0.05em 0 #13e8ff;
	}
	.shelf-sub {
		position: absolute;
		z-index: 2;
		margin: 0;
		top: calc(clamp(3.4rem, 9vh, 5rem) + clamp(1.9rem, 4.8vw, 3.15rem));
		left: 50%;
		transform: translateX(-50%);
		width: max-content;
		max-width: calc(100% - 2rem);
		text-align: center;
		font-size: clamp(0.66rem, 1.2vw, 0.78rem);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #00ff9c;
		transition: opacity 0.3s;
	}
	.full[data-mode='inspect'] .shelf-sub {
		opacity: 0;
	}
	/* the subtitle already says "pick a cd" */
	.full[data-mode='shelf']:has(.shelf-sub) .shelf-hint {
		visibility: hidden;
	}
	.full[data-mode='inspect'] .shelf-head {
		opacity: 0;
	}
	.shelf-head {
		transition: opacity 0.3s;
	}
	@media (max-width: 640px) {
		.shelf-head {
			top: 8.2rem;
		}
		.shelf-sub {
			top: 10.6rem;
			width: auto;
		}
		/* no room for both buttons: holding a cd, only "back to shelf" */
		[data-mode='inspect'] .shelf-exit {
			display: none;
		}
	}
	.shelf-label {
		top: 1rem;
		left: 1rem;
		display: grid;
		gap: 0.3rem;
		font-size: 0.7rem;
		color: #00ff9c;
	}
	.full .shelf-label {
		top: auto;
		bottom: clamp(5rem, 14vh, 8rem);
		left: 50%;
		transform: translateX(-50%);
		text-align: center;
	}
	.shelf-label :global(b) {
		font-family: var(--font-display);
		font-size: 1.4rem;
		letter-spacing: 0.02em;
		color: #e6e6e9;
	}
	.shelf-hint {
		left: 1rem;
		bottom: 1rem;
		font-size: 0.66rem;
		color: #5f6068;
	}
	.full .shelf-hint {
		left: 50%;
		bottom: clamp(3.4rem, 9vh, 5rem);
		transform: translateX(-50%);
		white-space: nowrap;
	}
	.shelf-back,
	.shelf-exit {
		right: 1rem;
		bottom: 1rem;
		padding: 0.6rem 0.9rem;
		font: inherit;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		color: #050506;
		background: #00ff9c;
		border: 0;
		cursor: pointer;
		text-decoration: none;
	}
	.full .shelf-back {
		top: clamp(3.4rem, 9vh, 5rem);
		bottom: auto;
		right: clamp(1rem, 3vw, 1.6rem);
	}
	.shelf-exit {
		background: none;
		color: #00ff9c;
		outline: 1px solid #00ff9c;
		left: clamp(1rem, 3vw, 1.6rem);
		right: auto;
		top: clamp(3.4rem, 9vh, 5rem);
		bottom: auto;
	}
	.shelf-back:hover,
	.shelf-exit:hover {
		filter: drop-shadow(-3px 0 0 #ff2e4d) drop-shadow(3px 0 0 #13e8ff);
	}
	.shelf-back[hidden],
	.shelf-label[hidden] {
		display: none;
	}

	/* liner-note pamphlet: a folded insert that drops in once the case is open */
	.pamphlet {
		position: absolute;
		z-index: 3;
		left: clamp(1rem, 6vw, 6rem);
		top: 50%;
		width: min(21rem, 30vw);
		padding: 1.3rem 1.4rem 1.1rem;
		color: #050506;
		background:
			linear-gradient(90deg, transparent 49.6%, rgba(5, 5, 6, 0.1) 50%, transparent 50.4%),
			repeating-linear-gradient(to bottom, transparent 0 3px, rgba(5, 5, 6, 0.035) 3px 4px),
			#e6e6e9;
		box-shadow: -4px 0 0 var(--cd, #ff2e4d), 4px 0 0 #13e8ff, 0 24px 60px rgba(0, 0, 0, 0.6);
		transform: translateY(-50%) rotate(-2.5deg);
		animation: pam-in 0.7s cubic-bezier(0.2, 1.4, 0.4, 1) 1.1s both;
	}
	.pamphlet[hidden] {
		display: none;
	}
	@keyframes pam-in {
		0% { opacity: 0; transform: translateY(-38%) rotate(-11deg) scale(0.85); clip-path: inset(0 0 100% 0); }
		40% { opacity: 1; }
		100% { opacity: 1; transform: translateY(-50%) rotate(-2.5deg); clip-path: inset(0 0 0 0); }
	}
	.pam-kicker {
		margin: 0 0 0.9rem;
		font-size: 0.62rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--cd, #ff2e4d);
		filter: brightness(0.75);
	}
	.pam-quote {
		margin: 0 0 1rem;
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 1.9vw, 1.6rem);
		line-height: 1.08;
		text-transform: uppercase;
		text-shadow: -2px 0 0 rgba(255, 46, 77, 0.55), 2px 0 0 rgba(19, 232, 255, 0.55);
	}
	.pam-notes {
		margin: 0;
		font-family: var(--font-body, inherit);
		font-size: 0.82rem;
		line-height: 1.5;
	}
	.pam-play {
		margin-top: 1rem;
		padding: 0.45rem 0.7rem;
		font: inherit;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		color: #e6e6e9;
		background: #050506;
		border: 0;
		cursor: pointer;
	}
	.pam-play[hidden] {
		display: none;
	}
	@media (max-width: 760px) {
		.pamphlet {
			left: 1rem;
			right: 1rem;
			top: auto;
			bottom: clamp(5.2rem, 12vh, 7rem);
			width: auto;
			max-height: 46vh;
			overflow: auto;
			transform: rotate(-1.5deg);
			animation-name: pam-in-m;
		}
		@keyframes pam-in-m {
			0% { opacity: 0; transform: translateY(30%) rotate(-7deg) scale(0.9); clip-path: inset(0 0 100% 0); }
			40% { opacity: 1; }
			100% { opacity: 1; transform: rotate(-1.5deg); clip-path: inset(0 0 0 0); }
		}
		[data-pamphlet-open] .shelf-label {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pamphlet { animation: none; }
	}
</style>

<script>
	import { mountShelf } from '../lib/shelf/shelf';
	for (const host of document.querySelectorAll<HTMLElement>('[data-shelf]')) {
		const cds = JSON.parse(host.querySelector('[data-shelf-data]')?.textContent || '[]');
		const pam = host.querySelector<HTMLElement>('[data-pamphlet]')!;
		const play = host.querySelector<HTMLButtonElement>('[data-pam-play]')!;
		let audio: HTMLAudioElement | null = null;
		let fade = 0;
		const fadeTo = (a: HTMLAudioElement, to: number, ms: number, done?: () => void) => {
			cancelAnimationFrame(fade);
			const from = a.volume, t0 = performance.now();
			const step = (now: number) => {
				const k = Math.min(1, (now - t0) / ms);
				a.volume = from + (to - from) * k;
				if (k < 1) fade = requestAnimationFrame(step);
				else done?.();
			};
			fade = requestAnimationFrame(step);
		};
		const stop = () => {
			if (!audio) return;
			const a = audio;
			audio = null;
			fadeTo(a, 0, 500, () => a.pause());
		};
		const setPlay = (on: boolean) => (play.textContent = on ? '[ ▮▮ stop the clip ]' : '[ ▶ play the clip ]');
		const startClip = (clip: { src: string; start: number; end?: number }) => {
			stop();
			const a = new Audio(clip.src);
			audio = a;
			a.volume = 0;
			a.addEventListener('loadedmetadata', () => (a.currentTime = clip.start), { once: true });
			a.addEventListener('timeupdate', () => {
				if (audio === a && clip.end != null && a.currentTime >= clip.end - 0.6) { stop(); setPlay(false); }
			});
			a.addEventListener('ended', () => setPlay(false));
			a.addEventListener('error', () => (play.hidden = true)); // no file yet
			a.play().then(() => { fadeTo(a, 1, 600); setPlay(true); }, () => setPlay(false));
		};
		play.addEventListener('click', () => {
			const clip = cds[Number(pam.dataset.i)]?.clip;
			if (!clip) return;
			if (audio && !audio.paused) { stop(); setPlay(false); } else startClip(clip);
		});
		mountShelf(
			host,
			cds,
			{
				label: host.querySelector('[data-shelf-label]')!,
				hint: host.querySelector('[data-shelf-hint]')!,
				back: host.querySelector('[data-shelf-back]')!,
				onOpen(i, open) {
					const cd = cds[i];
					if (!open || !cd || !(cd.quote || cd.notes)) {
						pam.hidden = true;
						delete host.dataset.pamphletOpen;
						stop();
						return;
					}
					pam.dataset.i = String(i);
					pam.style.setProperty('--cd', cd.color);
					host.querySelector('[data-pam-kicker]')!.textContent = `liner notes // ${cd.title} — ${cd.artist}`;
					const q = host.querySelector<HTMLElement>('[data-pam-quote]')!;
					// guillemets glued to the first/last word so they never wrap alone
					q.textContent = cd.quote ? `«\u00a0${cd.quote}\u00a0»` : '';
					q.hidden = !cd.quote;
					const n = host.querySelector<HTMLElement>('[data-pam-notes]')!;
					n.textContent = cd.notes ?? '';
					n.hidden = !cd.notes;
					play.hidden = !cd.clip;
					pam.hidden = false;
					host.dataset.pamphletOpen = '';
					// the tap that opened the case counts as the gesture that lets audio play
					if (cd.clip) startClip(cd.clip);
				},
			},
			{ full: host.classList.contains('full') },
		).catch(() => {
			const h = host.querySelector('[data-shelf-hint]');
			if (h) h.textContent = '> this browser cannot draw the shelf';
		});
	}
</script>
