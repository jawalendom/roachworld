---
// A plain-text page (About, Archive) set in the editor's-view key: near-black
// ground, cold white, acid green + glitch red, mono labels, a channel-split
// display headline in registration brackets, scanlines over the lot.
interface Props {
	kicker: string;
	title: string;
}
const { kicker, title } = Astro.props;
---

<main class="edp">
	<p class="edp-kick">&gt; {kicker}</p>
	<h1 class="edp-title">
		<span class="edp-br edp-br--tl" aria-hidden="true"></span>
		<span class="edp-t">{title}</span>
		<span class="edp-br edp-br--br" aria-hidden="true"></span>
	</h1>
	<slot />
	<p class="edp-eof">[ EOF ]<span class="edp-cur" aria-hidden="true">█</span></p>
</main>
<div class="edp-scan" aria-hidden="true"></div>

<script>
	// shrink the headline until it fits the column (display face is very wide)
	const fit = () => {
		for (const h of document.querySelectorAll<HTMLElement>('.edp-title')) {
			h.style.fontSize = '';
			const col = h.parentElement!.clientWidth - parseFloat(getComputedStyle(h.parentElement!).paddingLeft) * 2;
			let px = parseFloat(getComputedStyle(h).fontSize);
			while (h.scrollWidth > col && px > 16) h.style.fontSize = `${(px -= 1)}px`;
		}
	};
	document.fonts.ready.then(fit);
	addEventListener('resize', fit);
</script>

<style>
	.edp {
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(6rem, 16vh, 9rem) clamp(1.4rem, 6vw, 3rem) 6rem;
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.7;
		color: #e6e6e9;
	}
	.edp-kick {
		margin: 0 0 0.8rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: #00ff9c;
	}
	.edp-title {
		position: relative;
		display: inline-block;
		margin: 0 0 clamp(2rem, 6vh, 3rem);
		padding: 0.15em 0.3em;
		font-family: var(--font-display);
		font-weight: 800;
		/* fitted to the column in the script below; this is the starting size */
		font-size: clamp(2rem, 8.4vw, 4.2rem);
		max-width: 100%;
		white-space: nowrap;
		line-height: 1;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: #e6e6e9;
		text-shadow: 0.04em 0 #ff2e4d, -0.04em 0 #13e8ff;
		animation: edp-in 0.6s steps(6) both;
	}
	/* the clip-path reveal would cut the corner brackets off; reveal the text only */
	.edp-title {
		animation: none;
	}
	.edp-t {
		display: inline-block;
		animation: edp-in 0.6s steps(6) both;
	}
	@keyframes edp-in {
		0% { opacity: 0; clip-path: inset(0 100% 0 0); }
		60% { opacity: 1; }
		100% { clip-path: inset(0 0 0 0); }
	}
	/* registration brackets on two corners */
	.edp-br {
		position: absolute;
		width: 0.42em;
		height: 0.42em;
		border-color: #00ff9c;
		border-style: solid;
	}
	.edp-br--tl {
		top: -0.18em;
		left: -0.2em;
		border-width: 2px 0 0 2px;
	}
	.edp-br--br {
		bottom: -0.18em;
		right: -0.2em;
		border-width: 0 2px 2px 0;
	}
	.edp :global(a) {
		color: #00ff9c;
		text-decoration: none;
		border-bottom: 1px solid rgba(0, 255, 156, 0.45);
		background: none;
	}
	.edp :global(a:hover) {
		color: #e6e6e9;
		border-bottom-color: #ff2e4d;
	}
	.edp-eof {
		margin-top: 4rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		color: #5f6068;
	}
	.edp-cur {
		margin-left: 0.4em;
		color: #00ff9c;
		animation: edp-blink 1.1s steps(1) infinite;
	}
	@keyframes edp-blink {
		50% { opacity: 0; }
	}
	.edp-scan {
		position: fixed;
		inset: 0;
		z-index: 5;
		pointer-events: none;
		background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.24) 3px);
	}
	@media (prefers-reduced-motion: reduce) {
		.edp-title,
		.edp-cur {
			animation: none;
		}
	}
</style>
