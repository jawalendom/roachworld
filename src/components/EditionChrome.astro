---
// Bespoke navigation for the editor's view: Latest / Archive / About and a
// full-screen issue Index, all drawn in the hand-made key of the immersive view
// rather than the plain-view chrome. Palette + hand marks match src/editors/*.
//
// On an issue page the contents run down the right-hand side, after the
// table-of-contents in jhey.dev/prototypes/2025/toc-scroll-markers: every
// article listed, the one you're reading lit up with a small square marker that
// slides to it, and "back to top" once you're past the cover. "Contents" opens
// the full-screen index.
import type { Issue } from '../lib/issues';
import { articleSlug, articleOrder } from '../lib/issues';

interface Props {
	issue?: Issue;
	/** which nav destination is the current page */
	current?: 'latest' | 'archive' | 'about' | null;
}
const { issue, current = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = issue
	? issue.articles.map((a) => ({
			order: articleOrder(a),
			title: a.data.title,
			slug: articleSlug(a),
		}))
	: [];
const titleOf = issue?.data.title ?? '';

// hard segmented underlines — reads like a data strip, not a pen
const SCRAWLS = [
	'M0,4 H60',
	'M0,4 H22 M30,4 H60',
	'M0,4 H38 M44,4 H52 M56,4 H60',
];
---

<div class="edchrome" data-edchrome>
	<button type="button" class="edn-menu" data-nav-toggle aria-expanded="false" aria-controls="edn-links" aria-label="Open menu">
		<span class="edn-bar" aria-hidden="true"></span>
		<span class="edn-bar" aria-hidden="true"></span>
		<span class="edn-bar" aria-hidden="true"></span>
	</button>
	<nav class="edn" id="edn-links" aria-label="Roachworld" data-nav>
		{
			[
				{ label: 'Latest', href: `${base}/`, key: 'latest' },
				{ label: 'Archive', href: `${base}/archive/`, key: 'archive' },
				{ label: 'About', href: `${base}/about/`, key: 'about' },
			].map((l, i) => (
				<a
					href={l.href}
					aria-current={current === l.key ? 'page' : undefined}
				>
					{l.label}
					<svg class="sq" viewBox="0 0 60 7" preserveAspectRatio="none" aria-hidden="true">
						<path d={SCRAWLS[i % SCRAWLS.length]} />
					</svg>
				</a>
			))
		}
	</nav>

	{
		issue && items.length > 0 && (
			<>
				<nav class="toc" data-toc aria-label="Articles in this issue">
					<button type="button" class="toc-h" data-index-open aria-haspopup="dialog">
						Contents <span class="edx-no" data-index-count>{String(items.length).padStart(2, '0')}</span>
					</button>
					<ol class="toc-list">
						{items.map((it) => (
							<li>
								<a href={`#${it.slug}`} data-toc-jump={it.slug}>
									<span class="toc-no">{String(it.order).padStart(2, '0')}</span>
									<span class="toc-t">{it.title}</span>
								</a>
							</li>
						))}
					</ol>
					<span class="toc-marker" data-toc-marker aria-hidden="true"></span>
					<a href="#top" class="toc-top" data-toc-top>
						↑ Back to top
					</a>
				</nav>


				<div class="edx-panel" data-index-panel hidden role="dialog" aria-label="Issue contents">
					<div class="edx-inner">
						<p class="edx-kick">
							Zine {issue?.data.number} — {titleOf}
						</p>

						<ol class="edx-list">
							{items.map((it) => (
								<li>
									<a href={`#${it.slug}`} data-jump={it.slug}>
										<span class="edx-i">{String(it.order).padStart(2, '0')}</span>
										<span class="edx-t">
											{it.title}
											<svg class="sq sq-lg" viewBox="0 0 60 7" preserveAspectRatio="none" aria-hidden="true">
												<path d={SCRAWLS[it.order % SCRAWLS.length]} />
											</svg>
										</span>
									</a>
								</li>
							))}
						</ol>

						<div class="edx-foot">
							<a href={`${base}/archive/`}>Archive →</a>
							<a href={`${base}/about/`}>About</a>
							<button type="button" data-index-close>
								Close ✕
							</button>
						</div>
					</div>
				</div>
			</>
		)
	}
</div>

<style>
	.edchrome {
		--ed-ground: #050506;
		--ed-ink: #e6e6e9;
		--ed-dim: #5f6068;
		--ed-yellow: #00ff9c; /* accent (acid green) */
		--ed-blue: #ff2e4d; /* alt accent (glitch red) */
	}

	/* ── top-right nav ─────────────────────────────────────────── */
	.edn {
		position: fixed;
		top: clamp(0.8rem, 3vw, 1.5rem);
		right: clamp(0.8rem, 3vw, 1.5rem);
		z-index: 60;
		display: flex;
		gap: clamp(0.9rem, 3vw, 1.6rem);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		mix-blend-mode: difference;
	}
	/* phones: the row collapses into a dropdown (see the 640px block) */
	.edn-menu {
		display: none;
	}
	.edn a {
		position: relative;
		color: #fff;
		text-decoration: none;
		border: none;
		background: none;
		padding-bottom: 0.35em;
	}
	.edn .sq {
		position: absolute;
		left: -2px;
		right: -2px;
		bottom: 0;
		width: calc(100% + 4px);
		height: 6px;
		fill: none;
		stroke: var(--ed-yellow);
		stroke-width: 2;
		stroke-linecap: butt;
		opacity: 0;
		transform: scaleX(0.2);
		transform-origin: left;
		transition: opacity 0.1s steps(2), transform 0.16s steps(4);
	}
	.edn a:hover .sq,
	.edn a:focus-visible .sq,
	.edn a[aria-current='page'] .sq {
		opacity: 1;
		transform: scaleX(1);
	}
	.edn a[aria-current='page'] {
		color: var(--ed-yellow);
	}

	/* ── contents down the right-hand side ───────────────────── */
	.toc {
		position: fixed;
		z-index: 60;
		top: 50%;
		right: clamp(1rem, 3vw, 2rem);
		translate: 0 -50%;
		width: clamp(9rem, 15vw, 13rem);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		/* out of the way of the cover; slides in once you reach the articles */
		opacity: 0;
		translate: 0.6rem -50%;
		pointer-events: none;
		transition:
			opacity 0.3s cubic-bezier(0.215, 0.61, 0.355, 1),
			translate 0.3s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-shown] {
		opacity: 1;
		translate: 0 -50%;
		pointer-events: auto;
	}
	.toc-h {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.6rem;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		font: inherit;
		font-size: 0.58rem;
		letter-spacing: 0.18em;
		color: var(--ed-ink);
	}
	.toc-h:hover {
		color: var(--ed-yellow);
	}
	.edx-no {
		color: var(--ed-dim);
		font-size: 0.56rem;
		white-space: nowrap;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-list a {
		display: grid;
		grid-template-columns: 1.6rem 1fr;
		align-items: baseline;
		padding-block: 0.3rem;
		color: #6c6d75;
		text-decoration: none;
		background: none;
		border: none;
		transition: color 0.12s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc-no {
		font-size: 0.56rem;
		opacity: 0.8;
	}
	.toc-t {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	/* hover only where there's a real pointer: a phone keeps the last-tapped
	   link "hovered", which lit a second number next to the current one */
	@media (hover: hover) {
		.toc-list a:hover {
			color: var(--ed-ink);
		}
	}
	.toc-list a:focus-visible {
		color: var(--ed-ink);
	}
	.toc-list a[aria-current='true'] {
		color: var(--ed-yellow);
		text-shadow: 0.08em 0 #ff2e4d, -0.08em 0 #13e8ff;
	}
	/* the square that slides to the article you're in */
	.toc-marker {
		position: absolute;
		left: -0.9rem;
		top: 0;
		width: 6px;
		height: 6px;
		background: var(--ed-yellow);
		opacity: 0;
		transition:
			top 0.26s cubic-bezier(0.215, 0.61, 0.355, 1),
			opacity 0.26s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-active] .toc-marker {
		opacity: 1;
	}
	.toc-top {
		display: block;
		margin-top: 1rem;
		padding-top: 0.8rem;
		border-top: 1px solid rgba(230, 230, 233, 0.12);
		font-size: 0.56rem;
		letter-spacing: 0.16em;
		color: var(--ed-dim);
		text-decoration: none;
		background: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.26s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-active] .toc-top {
		opacity: 1;
		pointer-events: auto;
	}
	.toc-top:hover {
		color: var(--ed-yellow);
	}


	@media (max-width: 640px) {
		/* the menu button: three bars, a full 44px target, morphs to an X */
		.edn-menu {
			position: fixed;
			/* centred on the ROACHWORLD wordmark's line (top-left) */
			top: calc(clamp(0.8rem, 3vw, 1.5rem) + 0.5rem - 22px + 2px);
			right: clamp(0.35rem, 2vw, 1rem);
			z-index: 62;
			display: grid;
			align-content: center;
			justify-items: end;
			gap: 3.5px;
			width: 44px;
			height: 44px;
			padding: 0 10px;
			background: none;
			border: none;
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
		}
		.edn-bar {
			display: block;
			width: 22px;
			height: 2px;
			background: var(--ed-ink);
			transition:
				translate 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
				rotate 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
				opacity 0.18s,
				width 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
				background 0.2s;
		}
		/* a shorter middle bar in the accent: reads as ours, not a stock icon */
		.edn-bar:nth-child(2) {
			width: 15px;
			background: var(--ed-yellow);
		}
		/* every 5 seconds the bars ripple like a voice meter — each swells and
		   settles in turn, top to bottom, a wave rolling down through them in place */
		.edn-bar {
			transform-origin: right center;
			animation: edn-wave 5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.2s infinite;
		}
		.edn-bar:nth-child(2) {
			animation-delay: 1.36s;
		}
		.edn-bar:nth-child(3) {
			animation-delay: 1.52s;
		}
		/* one wave (~1.1s), then still: the cycle is 5s so it rolls every 5 seconds */
		@keyframes edn-wave {
			0%,
			22%,
			100% {
				scale: 1 1;
			}
			4% {
				scale: 0.45 1;
			}
			8.5% {
				scale: 1.12 1.35;
			}
			12.5% {
				scale: 0.9 1;
			}
			16% {
				scale: 1 1;
			}
		}
		/* open: the wave stops and the bars fold into the X */
		.edn-menu[aria-expanded='true'] .edn-bar {
			animation: none;
			transform-origin: center;
		}
		.edn-menu[aria-expanded='true'] .edn-bar:nth-child(1) {
			translate: 0 5.5px;
			rotate: 45deg;
		}
		.edn-menu[aria-expanded='true'] .edn-bar:nth-child(2) {
			opacity: 0;
			width: 0;
		}
		.edn-menu[aria-expanded='true'] .edn-bar:nth-child(3) {
			translate: 0 -5.5px;
			rotate: -45deg;
		}
		.edn-menu:focus-visible {
			outline: 1px solid var(--ed-yellow);
			outline-offset: -4px;
		}

		/* the menu itself: the whole screen, big type, nothing else competing */
		.edn {
			inset: 0;
			top: 0;
			right: 0;
			z-index: 61;
			flex-direction: column;
			justify-content: center;
			gap: 0;
			padding: 6rem clamp(1.5rem, 8vw, 2.5rem) 4rem;
			background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.22) 3px), #050506;
			mix-blend-mode: normal;
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.22s, visibility 0s 0.22s;
		}
		.edn[data-open] {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transition: opacity 0.22s;
		}
		.edn a {
			display: flex;
			align-items: baseline;
			gap: 1rem;
			padding: 1.1rem 0;
			border-top: 1px solid rgba(230, 230, 233, 0.12);
			font-family: var(--font-display);
			font-weight: 800;
			font-size: clamp(1.8rem, 9vw, 3rem);
			letter-spacing: 0.01em;
			line-height: 1;
			color: var(--ed-ink);
			text-shadow: 0.04em 0 #ff2e4d, -0.04em 0 #13e8ff;
			/* rise in one after another */
			opacity: 0;
			translate: 0 0.8rem;
			transition: opacity 0.3s, translate 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.15s;
		}
		.edn a:last-child {
			border-bottom: 1px solid rgba(230, 230, 233, 0.12);
		}
		.edn[data-open] a {
			opacity: 1;
			translate: 0 0;
		}
		.edn[data-open] a:nth-child(2) {
			transition-delay: 0.05s;
		}
		.edn[data-open] a:nth-child(3) {
			transition-delay: 0.1s;
		}
		/* index numbers, like the contents */
		.edn a::before {
			content: counter(edn, decimal-leading-zero);
			counter-increment: edn;
			font-family: var(--font-mono);
			font-weight: 400;
			font-size: 0.7rem;
			letter-spacing: 0.12em;
			color: var(--ed-dim);
			text-shadow: none;
			min-width: 1.6rem;
		}
		.edn {
			counter-reset: edn;
		}
		.edn a[aria-current='page'] {
			color: var(--ed-yellow);
		}
		.edn a[aria-current='page']::before {
			color: var(--ed-yellow);
		}
		.edn a:active {
			color: var(--ed-yellow);
		}
		.edn .sq {
			display: none;
		}
		/* while it's open the page underneath doesn't scroll */
		:global(html[data-nav-open]),
		:global(html[data-nav-open] body) {
			overflow: hidden;
		}
	}
	@media (max-width: 640px) {
		/* phones: just the numbers, a slim column on the right edge */
		.toc {
			width: auto;
			right: 0.5rem;
			padding: 0.4rem 0.45rem 0.4rem 0.9rem;
			background: rgba(5, 5, 6, 0.86);
			border: 1px solid rgba(0, 255, 156, 0.25);
		}
		.toc-h {
			display: none;
		}
		.toc-list a {
			grid-template-columns: auto;
			padding-block: 0.35rem;
		}
		.toc-t,
		.toc-top {
			display: none;
		}
		.toc-marker {
			left: 0.35rem;
		}
		.toc {
			transition:
				opacity 0.3s cubic-bezier(0.215, 0.61, 0.355, 1),
				translate 0.3s cubic-bezier(0.215, 0.61, 0.355, 1),
				width 0.28s cubic-bezier(0.215, 0.61, 0.355, 1),
				padding 0.28s cubic-bezier(0.215, 0.61, 0.355, 1);
		}
		/* tapped open: a proper panel with the titles; scrolling folds it back */
		.toc[data-expanded] {
			width: min(80vw, 19rem);
			padding: 0.9rem 0.9rem 0.8rem 1.4rem;
			background: rgba(5, 5, 6, 0.96);
			border-color: rgba(0, 255, 156, 0.5);
			box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
		}
		.toc[data-expanded] .toc-h {
			display: flex;
			font-size: 0.62rem;
		}
		.toc[data-expanded] .toc-list a {
			grid-template-columns: 2rem 1fr;
			padding-block: 0.55rem;
			border-top: 1px solid rgba(230, 230, 233, 0.08);
		}
		.toc[data-expanded] .toc-t {
			display: block;
			white-space: normal;
			font-family: var(--font-display);
			font-weight: 800;
			font-size: 0.86rem;
			letter-spacing: 0.02em;
			line-height: 1.15;
		}
		.toc[data-expanded] .toc-no {
			font-size: 0.62rem;
		}
		.toc[data-expanded] .toc-marker {
			left: 0.55rem;
		}
		.toc[data-expanded] .toc-top {
			display: block;
		}
	}

	/* ── contents panel ───────────────────────────────────────── */
	.edx-panel {
		position: fixed;
		inset: 0;
		z-index: 70;
		background: var(--ed-ground)
			repeating-linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0) 0,
				rgba(0, 0, 0, 0) 2px,
				rgba(0, 0, 0, 0.22) 3px
			);
		overflow-y: auto;
		animation: edx-in 0.18s steps(3) both;
	}
	.edx-panel[hidden] {
		display: none;
	}
	@keyframes edx-in {
		from {
			opacity: 0;
			transform: translateY(1.2rem);
		}
	}
	.edx-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: clamp(4rem, 12vh, 8rem) clamp(1.4rem, 6vw, 5rem) 5rem;
	}
	.edx-kick {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ed-blue);
		margin: 0 0 clamp(1.6rem, 5vh, 3rem);
	}
	.edx-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.edx-list a {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0 clamp(0.8rem, 2.5vw, 1.4rem);
		align-items: start;
		padding: clamp(0.7rem, 2.4vh, 1.3rem) 0;
		border-top: 1px solid rgba(237, 231, 214, 0.16);
		text-decoration: none;
		background: none;
		color: var(--ed-ink);
	}
	.edx-list li:last-child a {
		border-bottom: 1px solid rgba(237, 231, 214, 0.16);
	}
	.edx-i {
		/* same face and size as the title beside it */
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.45rem, 6vw, 3.4rem);
		line-height: 1.02;
		color: var(--ed-blue);
		/* same width on every row so the titles line up ("01" is narrower than "04") */
		min-width: 2.25em;
	}
	.edx-t {
		position: relative;
		display: inline;
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(1.45rem, 6vw, 3.4rem);
		line-height: 1.02;
		overflow-wrap: break-word;
		word-break: break-word;
		text-shadow: 0.04em 0 #ff2e4d, -0.04em 0 #13e8ff;
	}
	.edx-t .sq-lg {
		position: absolute;
		left: -0.1em;
		right: -0.1em;
		bottom: -0.12em;
		width: calc(100% + 0.2em);
		height: 0.16em;
		fill: none;
		stroke: var(--ed-yellow);
		stroke-width: 3;
		stroke-linecap: butt;
		opacity: 0;
		transform: scaleX(0.15);
		transform-origin: left;
		transition: opacity 0.1s steps(2), transform 0.18s steps(4);
	}
	.edx-list a:hover .sq-lg,
	.edx-list a:focus-visible .sq-lg,
	.edx-list a[aria-current='true'] .sq-lg {
		opacity: 1;
		transform: scaleX(1);
	}
	.edx-list a[aria-current='true'] .edx-i {
		color: var(--ed-yellow);
	}

	.edx-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
		margin-top: clamp(2.4rem, 7vh, 4rem);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.edx-foot a,
	.edx-foot button {
		color: var(--ed-dim);
		text-decoration: none;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
	}
	.edx-foot a:hover,
	.edx-foot button:hover {
		color: var(--ed-yellow);
	}

	@media (prefers-reduced-motion: reduce) {
		.edn,
		.edn a,
		.edn-bar {
			transition: none !important;
		}
		.edn-bar {
			animation: none !important;
		}
		.edx-panel {
			animation: none;
		}
		.toc-marker,
		.toc-top {
			transition-duration: 0s !important;
		}
		.edn .sq,
		.edx-t .sq-lg {
			transition: opacity 0.1s linear;
			transform: none;
		}
	}
</style>

<script>
	function initEditionChrome(root: HTMLElement) {
		// ── phones: the nav dropdown ──
		const navBtn = root.querySelector<HTMLButtonElement>('[data-nav-toggle]');
		const nav = root.querySelector<HTMLElement>('[data-nav]');
		if (navBtn && nav) {
			const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
			const setNav = (on: boolean) => {
				nav.toggleAttribute('data-open', on);
				navBtn.setAttribute('aria-expanded', String(on));
				navBtn.setAttribute('aria-label', on ? 'Close menu' : 'Open menu');
				document.documentElement.toggleAttribute('data-nav-open', on);
				if (on) links[0]?.focus({ preventScroll: true });
			};
			navBtn.addEventListener('click', () => setNav(!nav.hasAttribute('data-open')));
			// tapping the empty part of the panel closes it, as does Escape
			nav.addEventListener('click', (e) => {
				if (e.target === nav) setNav(false);
			});
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && nav.hasAttribute('data-open')) {
					setNav(false);
					navBtn.focus();
				}
				// keep Tab inside the open menu
				if (e.key === 'Tab' && nav.hasAttribute('data-open')) {
					const stops: HTMLElement[] = [navBtn, ...links];
					const i = stops.indexOf(document.activeElement as HTMLElement);
					const next = e.shiftKey ? (i <= 0 ? stops.length - 1 : i - 1) : (i + 1) % stops.length;
					e.preventDefault();
					stops[next].focus();
				}
			});
			// rotating to desktop width mid-menu shouldn't leave the page locked
			matchMedia('(min-width: 641px)').addEventListener('change', (m) => m.matches && setNav(false));
		}

		const openBtn = root.querySelector<HTMLButtonElement>('[data-index-open]');
		const panel = root.querySelector<HTMLElement>('[data-index-panel]');
		const closeBtn = root.querySelector<HTMLButtonElement>('[data-index-close]');
		const count = root.querySelector<HTMLElement>('[data-index-count]');
		const jumps = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-jump]'));

		const sheet = document.querySelector<HTMLElement>('[data-edition-sheet]');

		// ── panel open/close ──
		if (openBtn && panel && closeBtn) {
			const open = () => {
				panel.hidden = false;
				document.documentElement.style.overflow = 'hidden';
				closeBtn.focus();
			};
			const close = () => {
				panel.hidden = true;
				document.documentElement.style.overflow = '';
				openBtn.focus();
			};
			openBtn.addEventListener('click', open);
			closeBtn.addEventListener('click', close);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !panel.hidden) close();
			});
			jumps.forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					const id = a.dataset.jump!;
					close();
					const go = (sheet as any)?.__editionScrollTo as
						| ((id: string, smooth?: boolean) => void)
						| undefined;
					if (go) go(id);
					history.replaceState(null, '', `#${id}`);
				});
			});
		}


		// ── contents column ──
		const toc = root.querySelector<HTMLElement>('[data-toc]');
		const tocLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-jump]'));
		const marker = root.querySelector<HTMLElement>('[data-toc-marker]');
		const go = (id: string) => {
			const fn = (sheet as any)?.__editionScrollTo as ((id: string, smooth?: boolean) => void) | undefined;
			if (fn) fn(id);
			else document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
			history.replaceState(null, '', `#${id}`);
		};
		// phones: the column is just numbers; a tap opens it out with the titles,
		// and scrolling folds it back to numbers
		const narrow = matchMedia('(max-width: 640px)');
		let openedAt = 0;
		const expand = (on: boolean) => {
			if (!toc) return;
			toc.toggleAttribute('data-expanded', on);
			openedAt = window.scrollY;
			requestAnimationFrame(() => markTo(tocLinks.find((a) => a.getAttribute('aria-current') === 'true')));
		};
		toc?.addEventListener('click', (e) => {
			if (!narrow.matches || toc.hasAttribute('data-expanded')) return;
			e.preventDefault();
			e.stopPropagation();
			expand(true);
		}, true);
		window.addEventListener('scroll', () => {
			if (toc?.hasAttribute('data-expanded') && Math.abs(window.scrollY - openedAt) > 24) expand(false);
		}, { passive: true });
		document.addEventListener('pointerdown', (e) => {
			if (toc?.hasAttribute('data-expanded') && !toc.contains(e.target as Node)) expand(false);
		});
		tocLinks.forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				a.blur();
				go(a.dataset.tocJump!);
			}),
		);
		root.querySelector('[data-toc-top]')?.addEventListener('click', (e) => {
			e.preventDefault();
			window.scrollTo({ top: 0, behavior: 'smooth' });
			history.replaceState(null, '', location.pathname);
		});
		const markTo = (a: HTMLAnchorElement | undefined) => {
			if (!toc || !marker) return;
			toc.toggleAttribute('data-active', !!a);
			if (a) marker.style.top = `${a.offsetTop + a.offsetHeight / 2 - 3}px`;
		};

		// ── scroll-spy against the sheet's registered marks ──
		if (!sheet) return;
		const total = jumps.length;
		let currentId = '';

		const spy = () => {
			const marks = (sheet as any).__editionMarks as { id: string; y: number }[] | undefined;
			if (!marks || !marks.length) return;
			const sy = window.scrollY - sheet.offsetTop + window.innerHeight * 0.28;
			let active = marks[0].id;
			for (const m of marks) if (m.y <= sy) active = m.id;
			// on the cover (before the first article) nothing is lit
			const onCover = sy < marks[0].y;
			toc?.toggleAttribute('data-shown', !onCover);
			const key = onCover ? '' : active;
			if (key === currentId) return;
			currentId = key;

			const i = jumps.findIndex((a) => a.dataset.jump === active);
			if (count) {
				count.textContent =
					i >= 0
						? `${String(i + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`
						: String(total).padStart(2, '0');
			}
			jumps.forEach((a) =>
				a.setAttribute('aria-current', a.dataset.jump === active ? 'true' : 'false'),
			);
			const lit = onCover ? undefined : tocLinks.find((a) => a.dataset.tocJump === active);
			tocLinks.forEach((a) => a.setAttribute('aria-current', a === lit ? 'true' : 'false'));
			markTo(lit);
		};

		const start = () => {
			spy();
			window.addEventListener('scroll', spy, { passive: true });
		};
		if ((sheet as any).__editionMarks) start();
		else sheet.addEventListener('edition:built', start, { once: true });
	}

	document
		.querySelectorAll<HTMLElement>('[data-edchrome]')
		.forEach((el) => initEditionChrome(el));
</script>
