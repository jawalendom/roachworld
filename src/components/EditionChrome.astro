---
// Bespoke navigation for the editor's view: Latest / Archive / About and a
// full-screen issue Index, all drawn in the hand-made key of the immersive view
// rather than the plain-view chrome. Palette + hand marks match src/editors/*.
//
// On an issue page the contents run down the right-hand side, after the
// table-of-contents in jhey.dev/prototypes/2025/toc-scroll-markers: every
// article listed, the one you're reading lit up with a small square marker that
// slides to it, and "back to top" once you're past the cover. "Contents" opens
// the full-screen index.
import type { Issue } from '../lib/issues';
import { articleSlug, articleOrder } from '../lib/issues';

interface Props {
	issue?: Issue;
	/** which nav destination is the current page */
	current?: 'latest' | 'archive' | 'about' | null;
}
const { issue, current = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const items = issue
	? issue.articles.map((a) => ({
			order: articleOrder(a),
			title: a.data.title,
			slug: articleSlug(a),
		}))
	: [];
const titleOf = issue?.data.title ?? '';

// hard segmented underlines — reads like a data strip, not a pen
const SCRAWLS = [
	'M0,4 H60',
	'M0,4 H22 M30,4 H60',
	'M0,4 H38 M44,4 H52 M56,4 H60',
];
---

<div class="edchrome" data-edchrome>
	<nav class="edn" aria-label="Roachworld">
		{
			[
				{ label: 'Latest', href: `${base}/`, key: 'latest' },
				{ label: 'Archive', href: `${base}/archive/`, key: 'archive' },
				{ label: 'About', href: `${base}/about/`, key: 'about' },
			].map((l, i) => (
				<a
					href={l.href}
					aria-current={current === l.key ? 'page' : undefined}
				>
					{l.label}
					<svg class="sq" viewBox="0 0 60 7" preserveAspectRatio="none" aria-hidden="true">
						<path d={SCRAWLS[i % SCRAWLS.length]} />
					</svg>
				</a>
			))
		}
	</nav>

	{
		issue && items.length > 0 && (
			<>
				<nav class="toc" data-toc aria-label="Articles in this issue">
					<button type="button" class="toc-h" data-index-open aria-haspopup="dialog">
						Contents <span class="edx-no" data-index-count>{String(items.length).padStart(2, '0')}</span>
					</button>
					<ol class="toc-list">
						{items.map((it) => (
							<li>
								<a href={`#${it.slug}`} data-toc-jump={it.slug}>
									<span class="toc-no">{String(it.order).padStart(2, '0')}</span>
									<span class="toc-t">{it.title}</span>
								</a>
							</li>
						))}
					</ol>
					<span class="toc-marker" data-toc-marker aria-hidden="true"></span>
					<a href="#top" class="toc-top" data-toc-top>
						↑ Back to top
					</a>
				</nav>


				<div class="edx-panel" data-index-panel hidden role="dialog" aria-label="Issue contents">
					<div class="edx-inner">
						<p class="edx-kick">
							Vol {issue?.data.number} — {titleOf}
						</p>

						<ol class="edx-list">
							{items.map((it) => (
								<li>
									<a href={`#${it.slug}`} data-jump={it.slug}>
										<span class="edx-i">{String(it.order).padStart(2, '0')}</span>
										<span class="edx-t">
											{it.title}
											<svg class="sq sq-lg" viewBox="0 0 60 7" preserveAspectRatio="none" aria-hidden="true">
												<path d={SCRAWLS[it.order % SCRAWLS.length]} />
											</svg>
										</span>
									</a>
								</li>
							))}
						</ol>

						<div class="edx-foot">
							<a href={`${base}/archive/`}>Archive →</a>
							<a href={`${base}/about/`}>About</a>
							<button type="button" data-index-close>
								Close ✕
							</button>
						</div>
					</div>
				</div>
			</>
		)
	}
</div>

<style>
	.edchrome {
		--ed-ground: #050506;
		--ed-ink: #e6e6e9;
		--ed-dim: #5f6068;
		--ed-yellow: #00ff9c; /* accent (acid green) */
		--ed-blue: #ff2e4d; /* alt accent (glitch red) */
	}

	/* ── top-right nav ─────────────────────────────────────────── */
	.edn {
		position: fixed;
		top: clamp(0.8rem, 3vw, 1.5rem);
		right: clamp(0.8rem, 3vw, 1.5rem);
		z-index: 60;
		display: flex;
		gap: clamp(0.9rem, 3vw, 1.6rem);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.13em;
		text-transform: uppercase;
		mix-blend-mode: difference;
	}
	.edn a {
		position: relative;
		color: #fff;
		text-decoration: none;
		border: none;
		background: none;
		padding-bottom: 0.35em;
	}
	.edn .sq {
		position: absolute;
		left: -2px;
		right: -2px;
		bottom: 0;
		width: calc(100% + 4px);
		height: 6px;
		fill: none;
		stroke: var(--ed-yellow);
		stroke-width: 2;
		stroke-linecap: butt;
		opacity: 0;
		transform: scaleX(0.2);
		transform-origin: left;
		transition: opacity 0.1s steps(2), transform 0.16s steps(4);
	}
	.edn a:hover .sq,
	.edn a:focus-visible .sq,
	.edn a[aria-current='page'] .sq {
		opacity: 1;
		transform: scaleX(1);
	}
	.edn a[aria-current='page'] {
		color: var(--ed-yellow);
	}

	/* ── contents down the right-hand side ───────────────────── */
	.toc {
		position: fixed;
		z-index: 60;
		top: 50%;
		right: clamp(1rem, 3vw, 2rem);
		translate: 0 -50%;
		width: clamp(9rem, 15vw, 13rem);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		/* out of the way of the cover; slides in once you reach the articles */
		opacity: 0;
		translate: 0.6rem -50%;
		pointer-events: none;
		transition:
			opacity 0.3s cubic-bezier(0.215, 0.61, 0.355, 1),
			translate 0.3s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-shown] {
		opacity: 1;
		translate: 0 -50%;
		pointer-events: auto;
	}
	.toc-h {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 0.6rem;
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		font: inherit;
		font-size: 0.58rem;
		letter-spacing: 0.18em;
		color: var(--ed-ink);
	}
	.toc-h:hover {
		color: var(--ed-yellow);
	}
	.edx-no {
		color: var(--ed-dim);
		font-size: 0.56rem;
		white-space: nowrap;
	}
	.toc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.toc-list a {
		display: grid;
		grid-template-columns: 1.6rem 1fr;
		align-items: baseline;
		padding-block: 0.3rem;
		color: #6c6d75;
		text-decoration: none;
		background: none;
		border: none;
		transition: color 0.12s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc-no {
		font-size: 0.56rem;
		opacity: 0.8;
	}
	.toc-t {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.toc-list a:is(:hover, :focus-visible) {
		color: var(--ed-ink);
	}
	.toc-list a[aria-current='true'] {
		color: var(--ed-yellow);
		text-shadow: 0.08em 0 #ff2e4d, -0.08em 0 #13e8ff;
	}
	/* the square that slides to the article you're in */
	.toc-marker {
		position: absolute;
		left: -0.9rem;
		top: 0;
		width: 6px;
		height: 6px;
		background: var(--ed-yellow);
		opacity: 0;
		transition:
			top 0.26s cubic-bezier(0.215, 0.61, 0.355, 1),
			opacity 0.26s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-active] .toc-marker {
		opacity: 1;
	}
	.toc-top {
		display: block;
		margin-top: 1rem;
		padding-top: 0.8rem;
		border-top: 1px solid rgba(230, 230, 233, 0.12);
		font-size: 0.56rem;
		letter-spacing: 0.16em;
		color: var(--ed-dim);
		text-decoration: none;
		background: none;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.26s cubic-bezier(0.215, 0.61, 0.355, 1);
	}
	.toc[data-active] .toc-top {
		opacity: 1;
		pointer-events: auto;
	}
	.toc-top:hover {
		color: var(--ed-yellow);
	}


	@media (max-width: 640px) {
		/* phones: just the numbers, a slim column on the right edge */
		.toc {
			width: auto;
			right: 0.5rem;
			padding: 0.4rem 0.45rem 0.4rem 0.9rem;
			background: rgba(5, 5, 6, 0.86);
			border: 1px solid rgba(0, 255, 156, 0.25);
		}
		.toc-h {
			display: none;
		}
		.toc-list a {
			grid-template-columns: auto;
			padding-block: 0.35rem;
		}
		.toc-t,
		.toc-top {
			display: none;
		}
		.toc-marker {
			left: 0.35rem;
		}
	}

	/* ── contents panel ───────────────────────────────────────── */
	.edx-panel {
		position: fixed;
		inset: 0;
		z-index: 70;
		background: var(--ed-ground)
			repeating-linear-gradient(
				to bottom,
				rgba(0, 0, 0, 0) 0,
				rgba(0, 0, 0, 0) 2px,
				rgba(0, 0, 0, 0.22) 3px
			);
		overflow-y: auto;
		animation: edx-in 0.18s steps(3) both;
	}
	.edx-panel[hidden] {
		display: none;
	}
	@keyframes edx-in {
		from {
			opacity: 0;
			transform: translateY(1.2rem);
		}
	}
	.edx-inner {
		max-width: 1100px;
		margin: 0 auto;
		padding: clamp(4rem, 12vh, 8rem) clamp(1.4rem, 6vw, 5rem) 5rem;
	}
	.edx-kick {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ed-blue);
		margin: 0 0 clamp(1.6rem, 5vh, 3rem);
	}
	.edx-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.edx-list a {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0 clamp(0.8rem, 2.5vw, 1.4rem);
		align-items: start;
		padding: clamp(0.7rem, 2.4vh, 1.3rem) 0;
		border-top: 1px solid rgba(237, 231, 214, 0.16);
		text-decoration: none;
		background: none;
		color: var(--ed-ink);
	}
	.edx-list li:last-child a {
		border-bottom: 1px solid rgba(237, 231, 214, 0.16);
	}
	.edx-i {
		/* same face and size as the title beside it */
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.45rem, 6vw, 3.4rem);
		line-height: 1.02;
		color: var(--ed-blue);
		/* same width on every row so the titles line up ("01" is narrower than "04") */
		min-width: 2.25em;
	}
	.edx-t {
		position: relative;
		display: inline;
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(1.45rem, 6vw, 3.4rem);
		line-height: 1.02;
		overflow-wrap: break-word;
		word-break: break-word;
		text-shadow: 0.04em 0 #ff2e4d, -0.04em 0 #13e8ff;
	}
	.edx-t .sq-lg {
		position: absolute;
		left: -0.1em;
		right: -0.1em;
		bottom: -0.12em;
		width: calc(100% + 0.2em);
		height: 0.16em;
		fill: none;
		stroke: var(--ed-yellow);
		stroke-width: 3;
		stroke-linecap: butt;
		opacity: 0;
		transform: scaleX(0.15);
		transform-origin: left;
		transition: opacity 0.1s steps(2), transform 0.18s steps(4);
	}
	.edx-list a:hover .sq-lg,
	.edx-list a:focus-visible .sq-lg,
	.edx-list a[aria-current='true'] .sq-lg {
		opacity: 1;
		transform: scaleX(1);
	}
	.edx-list a[aria-current='true'] .edx-i {
		color: var(--ed-yellow);
	}

	.edx-foot {
		display: flex;
		flex-wrap: wrap;
		gap: 1.4rem;
		margin-top: clamp(2.4rem, 7vh, 4rem);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	.edx-foot a,
	.edx-foot button {
		color: var(--ed-dim);
		text-decoration: none;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
	}
	.edx-foot a:hover,
	.edx-foot button:hover {
		color: var(--ed-yellow);
	}

	@media (prefers-reduced-motion: reduce) {
		.edx-panel {
			animation: none;
		}
		.toc-marker,
		.toc-top {
			transition-duration: 0s !important;
		}
		.edn .sq,
		.edx-t .sq-lg {
			transition: opacity 0.1s linear;
			transform: none;
		}
	}
</style>

<script>
	function initEditionChrome(root: HTMLElement) {
		const openBtn = root.querySelector<HTMLButtonElement>('[data-index-open]');
		const panel = root.querySelector<HTMLElement>('[data-index-panel]');
		const closeBtn = root.querySelector<HTMLButtonElement>('[data-index-close]');
		const count = root.querySelector<HTMLElement>('[data-index-count]');
		const jumps = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-jump]'));

		const sheet = document.querySelector<HTMLElement>('[data-edition-sheet]');

		// ── panel open/close ──
		if (openBtn && panel && closeBtn) {
			const open = () => {
				panel.hidden = false;
				document.documentElement.style.overflow = 'hidden';
				closeBtn.focus();
			};
			const close = () => {
				panel.hidden = true;
				document.documentElement.style.overflow = '';
				openBtn.focus();
			};
			openBtn.addEventListener('click', open);
			closeBtn.addEventListener('click', close);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !panel.hidden) close();
			});
			jumps.forEach((a) => {
				a.addEventListener('click', (e) => {
					e.preventDefault();
					const id = a.dataset.jump!;
					close();
					const go = (sheet as any)?.__editionScrollTo as
						| ((id: string, smooth?: boolean) => void)
						| undefined;
					if (go) go(id);
					history.replaceState(null, '', `#${id}`);
				});
			});
		}


		// ── contents column ──
		const toc = root.querySelector<HTMLElement>('[data-toc]');
		const tocLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-toc-jump]'));
		const marker = root.querySelector<HTMLElement>('[data-toc-marker]');
		const go = (id: string) => {
			const fn = (sheet as any)?.__editionScrollTo as ((id: string, smooth?: boolean) => void) | undefined;
			if (fn) fn(id);
			else document.getElementById(id)?.scrollIntoView({ behavior: 'smooth' });
			history.replaceState(null, '', `#${id}`);
		};
		tocLinks.forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				go(a.dataset.tocJump!);
			}),
		);
		root.querySelector('[data-toc-top]')?.addEventListener('click', (e) => {
			e.preventDefault();
			window.scrollTo({ top: 0, behavior: 'smooth' });
			history.replaceState(null, '', location.pathname);
		});
		const markTo = (a: HTMLAnchorElement | undefined) => {
			if (!toc || !marker) return;
			toc.toggleAttribute('data-active', !!a);
			if (a) marker.style.top = `${a.offsetTop + a.offsetHeight / 2 - 3}px`;
		};

		// ── scroll-spy against the sheet's registered marks ──
		if (!sheet) return;
		const total = jumps.length;
		let currentId = '';

		const spy = () => {
			const marks = (sheet as any).__editionMarks as { id: string; y: number }[] | undefined;
			if (!marks || !marks.length) return;
			const sy = window.scrollY - sheet.offsetTop + window.innerHeight * 0.28;
			let active = marks[0].id;
			for (const m of marks) if (m.y <= sy) active = m.id;
			// on the cover (before the first article) nothing is lit
			const onCover = sy < marks[0].y;
			toc?.toggleAttribute('data-shown', !onCover);
			const key = onCover ? '' : active;
			if (key === currentId) return;
			currentId = key;

			const i = jumps.findIndex((a) => a.dataset.jump === active);
			if (count) {
				count.textContent =
					i >= 0
						? `${String(i + 1).padStart(2, '0')} / ${String(total).padStart(2, '0')}`
						: String(total).padStart(2, '0');
			}
			jumps.forEach((a) =>
				a.setAttribute('aria-current', a.dataset.jump === active ? 'true' : 'false'),
			);
			const lit = onCover ? undefined : tocLinks.find((a) => a.dataset.tocJump === active);
			tocLinks.forEach((a) => a.setAttribute('aria-current', a === lit ? 'true' : 'false'));
			markTo(lit);
		};

		const start = () => {
			spy();
			window.addEventListener('scroll', spy, { passive: true });
		};
		if ((sheet as any).__editionMarks) start();
		else sheet.addEventListener('edition:built', start, { once: true });
	}

	document
		.querySelectorAll<HTMLElement>('[data-edchrome]')
		.forEach((el) => initEditionChrome(el));
</script>
