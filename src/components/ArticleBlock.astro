---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import ArticleNumber from './ArticleNumber.astro';

interface Props {
	anchor: string;
	order: number;
	deepHref: string;
	title: string;
	dek: string;
	kicker: string;
	byline: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: ImageMetadata;
	tags: string[];
}
const { anchor, order, deepHref, title, dek, kicker, byline, pubDate, updatedDate, heroImage, tags } =
	Astro.props;
const no = String(order).padStart(2, '0');
const ORDINALS = [
	'',
	'One',
	'Two',
	'Three',
	'Four',
	'Five',
	'Six',
	'Seven',
	'Eight',
	'Nine',
	'Ten',
	'Eleven',
	'Twelve',
];
const ordinal = ORDINALS[order] ?? `No. ${order}`;
---

<article id={anchor} class="article">
	<hr class="article-rule" aria-hidden="true" />

	<div class="article-head">
		<ArticleNumber n={no} label={ordinal} />
		<div class="article-headline">
			<p class="kicker">{kicker}</p>
			<h2>{title}</h2>
			<p class="dek">{dek}</p>
			<p class="byline">
				By {byline} · <FormattedDate date={pubDate} />
				{updatedDate && <> · updated <FormattedDate date={updatedDate} /></>}
				· <a href={deepHref}>read as a spread →</a>
			</p>
		</div>
	</div>

	{
		heroImage && (
			<figure class="hero">
				<Image src={heroImage} alt="" width={1400} height={840} />
			</figure>
		)
	}

	<div class="prose">
		<slot />
	</div>

	{
		tags.length > 0 && (
			<ul class="tags">
				{tags.map((t) => (
					<li>#{t}</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.article {
		scroll-margin-top: 5rem;
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}
	.article-rule {
		border: none;
		border-top: 5px solid var(--ink);
		margin: 0 0 1.6rem;
	}
	.article-head {
		display: grid;
		grid-template-columns: minmax(5rem, 7.5rem) 1fr;
		gap: 0 clamp(1.25rem, 3vw, 2.75rem);
		align-items: start;
		margin-bottom: 2rem;
	}
	.article-headline {
		max-width: 40rem;
		padding-top: 0.1rem;
	}
	.article-headline .kicker {
		display: block;
		margin: 0 0 0.5rem;
	}
	.article-headline h2 {
		font-family: var(--font-display);
		font-weight: 800;
		text-transform: uppercase;
		font-size: clamp(2rem, 6vw, 3.6rem);
		line-height: 1;
		margin: 0.25em 0 0.35em;
		max-width: 16ch;
		overflow-wrap: normal;
		hyphens: auto;
	}
	.article-headline .dek {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: clamp(1.05rem, 2.4vw, 1.45rem);
		line-height: 1.3;
		margin: 0 0 0.9rem;
	}
	.article-headline .byline {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin: 0;
	}
	.hero {
		margin: 0 0 2.2rem;
		grid-column: 1 / -1;
	}
	.hero :global(img) {
		width: 100%;
		height: auto;
		border: 3px solid var(--ink);
		box-shadow: 8px 8px 0 var(--blue);
		filter: grayscale(1) contrast(1.15);
	}
	.tags {
		list-style: none;
		padding: 0;
		margin: 2.5rem 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.74rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	.tags li {
		border: 2px solid var(--blue);
		color: var(--blue);
		padding: 0.15em 0.55em;
	}

	@media (max-width: 640px) {
		.article-head {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}
	}
</style>
