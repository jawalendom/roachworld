---
// A text-message thread for the HTML views, in the editor view's glitch key.
// Bubbles land as they scroll into view; replies from `them` show a three-dot
// typing bubble first.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	me: string;
	them: string;
	messages: { from: 'me' | 'them'; text?: string; at?: string; image?: ImageMetadata }[];
	/** cut-off thread: end on `them` typing and a link to the full piece. */
	moreHref?: string;
}
const { me, them, messages, moreHref } = Astro.props;
const PARA = new RegExp('\\n\\s*\\n');
const parasOf = (text = '') => text.split(PARA);
---

<div class="chat" data-chat>
	{
		messages.map((m, i) => {
			const prev = messages[i - 1];
			const showTag = m.at || !prev || prev.from !== m.from;
			return (
				<>
					{m.at && <p class="chat-at">{m.at.replace(' at ', '  //  ')}</p>}
					{showTag && <p class={`chat-tag ${m.from}`}>{m.from === 'me' ? `${me} <` : `> ${them}`}</p>}
					<div class={`chat-row ${m.from}`} data-chat-row>
						{m.from === 'them' && (
							<div class="chat-typing" aria-hidden="true">
								<span />
								<span />
								<span />
							</div>
						)}
						<div class={`chat-bubble ${m.image ? 'img' : ''}`}>
							{m.image ? (
								<Image src={m.image} alt={`Photo from ${them}`} width={560} />
							) : (
								parasOf(m.text).map((p) => <p>{p}</p>)
							)}
						</div>
					</div>
					{!moreHref && i === messages.length - 1 && m.from === 'me' && <p class="chat-delivered">Delivered</p>}
				</>
			);
		})
	}
	{
		moreHref && (
			<>
				<p class="chat-tag them">{`> ${them} is typing`}</p>
				<div class="chat-typing chat-teaser" aria-hidden="true">
					<span />
					<span />
					<span />
				</div>
				<a class="chat-more" href={moreHref}>[ Read the full interview -&gt; ]</a>
			</>
		)
	}
</div>

<style>
	.chat {
		--c-ground: #050506;
		--c-ink: #e6e6e9;
		--c-dim: #5f6068;
		--c-green: #00ff9c;
		--c-red: #ff2e4d;
		--c-cyan: #13e8ff;
		position: relative;
		margin: 2rem 0;
		padding: clamp(1rem, 4vw, 2rem);
		background: var(--c-ground);
		color: var(--c-ink);
		border: 1px solid color-mix(in srgb, var(--c-green) 35%, transparent);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}
	.chat::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: repeating-linear-gradient(to bottom, transparent 0 2px, rgba(0, 0, 0, 0.22) 3px);
	}
	.chat-at,
	.chat-tag,
	.chat-delivered {
		font-family: var(--font-mono);
		text-transform: uppercase;
		margin: 0;
	}
	.chat-at {
		align-self: center;
		margin: 1.4rem 0 0.6rem;
		font-size: 0.68rem;
		letter-spacing: 0.2em;
		color: var(--c-dim);
		white-space: pre;
	}
	.chat-tag {
		margin: 0.9rem 0.3rem 0.35rem;
		font-size: 0.62rem;
		letter-spacing: 0.3em;
	}
	.chat-tag.them {
		color: var(--c-cyan);
	}
	.chat-tag.me {
		align-self: flex-end;
		color: var(--c-green);
	}
	.chat-delivered {
		align-self: flex-end;
		margin-top: 0.3rem;
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		color: var(--c-dim);
	}
	.chat-row {
		position: relative;
		display: flex;
		margin-top: 0.4rem;
	}
	.chat-row.me {
		justify-content: flex-end;
	}
	.chat-bubble {
		max-width: min(80%, 28rem);
		padding: 0.6rem 0.95rem;
		border-radius: 18px;
		font-family: var(--font-body);
		font-size: 1.02rem;
		line-height: 1.4;
	}
	.chat-bubble p {
		margin: 0;
	}
	.chat-bubble p + p {
		margin-top: 0.75em;
	}
	.me .chat-bubble {
		background: var(--c-green);
		color: var(--c-ground);
		border-bottom-right-radius: 5px;
	}
	.them .chat-bubble {
		background: #0d1013;
		border: 1px solid color-mix(in srgb, var(--c-cyan) 45%, transparent);
		border-bottom-left-radius: 5px;
	}
	.chat-bubble.img {
		padding: 0;
		overflow: hidden;
		width: min(70%, 280px);
	}
	.chat-bubble.img img {
		display: block;
		width: 100%;
		height: auto;
	}

	.chat-typing {
		position: absolute;
		left: 0;
		top: 0;
		display: none;
		gap: 6px;
		align-items: center;
		padding: 0 16px;
		height: 36px;
		border-radius: 18px 18px 18px 5px;
		background: #0d1013;
		border: 1px solid color-mix(in srgb, var(--c-cyan) 45%, transparent);
	}
	.chat-typing span {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--c-cyan);
		animation: chat-dot 1.1s infinite;
	}
	.chat-typing span:nth-child(2) {
		animation-delay: 0.16s;
	}
	.chat-typing span:nth-child(3) {
		animation-delay: 0.32s;
	}
	.chat-typing.chat-teaser {
		position: static;
		display: flex;
		width: max-content;
		margin-top: 0.4rem;
	}
	.chat-more {
		align-self: center;
		margin-top: 1.6rem;
		padding: 0.9rem 1.4rem;
		font-family: var(--font-mono);
		font-size: clamp(0.66rem, 2.6vw, 0.8rem);
		letter-spacing: clamp(0.08em, 0.6vw, 0.2em);
		white-space: nowrap;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--c-ground);
		background: var(--c-green);
		outline: 2px solid var(--c-green);
		outline-offset: 6px;
		animation: chat-more-glitch 4s steps(1) infinite;
	}
	.chat-more:hover,
	.chat-more:focus-visible {
		filter: drop-shadow(-3px 0 0 var(--c-red)) drop-shadow(3px 0 0 var(--c-cyan));
	}
	@keyframes chat-more-glitch {
		0%,
		92%,
		100% {
			transform: none;
			filter: none;
		}
		93% {
			transform: translateX(-5px) skewX(-6deg);
			filter: drop-shadow(-4px 0 0 var(--c-red)) drop-shadow(4px 0 0 var(--c-cyan));
		}
		95% {
			transform: translateX(4px);
		}
	}
	@keyframes chat-dot {
		0%,
		60%,
		100% {
			transform: translateY(0);
			opacity: 0.45;
		}
		25% {
			transform: translateY(-5px);
			opacity: 1;
		}
	}

	/* scroll states (only once JS has armed the thread) */
	.chat[data-armed] .chat-row .chat-bubble {
		visibility: hidden;
	}
	.chat[data-armed] .chat-row[data-state='typing'] .chat-typing {
		display: flex;
	}
	.chat[data-armed] .chat-row[data-state='in'] .chat-bubble {
		visibility: visible;
		animation: chat-land 0.38s steps(6) both;
	}
	@keyframes chat-land {
		0% {
			transform: translateX(-14px) skewX(-8deg);
			filter: drop-shadow(-6px 0 0 var(--c-red)) drop-shadow(6px 0 0 var(--c-cyan));
			clip-path: inset(0 0 55% 0);
		}
		40% {
			transform: translateX(10px);
			clip-path: inset(30% 0 0 0);
		}
		70% {
			transform: translateX(-4px);
			filter: drop-shadow(-2px 0 0 var(--c-red)) drop-shadow(2px 0 0 var(--c-cyan));
			clip-path: inset(0 0 0 0);
		}
		100% {
			transform: none;
			filter: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.chat[data-armed] .chat-row[data-state='in'] .chat-bubble {
			animation: none;
		}
		.chat-typing span {
			animation: none;
		}
	}
</style>

<script>
	// Reveal bubbles one at a time as they scroll in. A reply shows the typing
	// bubble while it sits in the lower part of the screen, then lands.
	for (const chat of document.querySelectorAll<HTMLElement>('[data-chat]')) {
		const rows = [...chat.querySelectorAll<HTMLElement>('[data-chat-row]')];
		chat.dataset.armed = '';
		const update = () => {
			const vh = window.innerHeight;
			let blocked = false;
			for (const row of rows) {
				if (row.dataset.state === 'in') continue;
				const top = row.getBoundingClientRect().top;
				const isThem = row.classList.contains('them');
				// in order: nothing lands before the message above it
				if (blocked || top > vh * 0.88) {
					delete row.dataset.state;
					blocked = true;
					continue;
				}
				if (isThem && top > vh * 0.62) {
					row.dataset.state = 'typing';
					blocked = true;
				} else {
					row.dataset.state = 'in';
				}
			}
		};
		update();
		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', update);
	}
</script>
