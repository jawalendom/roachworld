---
import { render } from 'astro:content';
import IssueMasthead from './IssueMasthead.astro';
import ArticleBlock from './ArticleBlock.astro';
import IssueIndex from './IssueIndex.astro';
import Chat from './Chat.astro';
import AsciiRoaches from './AsciiRoaches.astro';
import ShelfDisc from './ShelfDisc.astro';
import { parseBody } from '../lib/editor/parseBody';
import { articleSlug, articleOrder, type Issue } from '../lib/issues';

interface Props {
	issue: Issue;
	label?: string;
}
const { issue, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const articles = await Promise.all(
	issue.articles.map(async (a) => {
		const { Content } = await render(a);
		// `{/* read-more */}` in the body: show only what's above it here
		const blocks = parseBody(a.body ?? '');
		const cut = blocks.findIndex((b) => b.type === 'more');
		const preview = cut >= 0 ? blocks.slice(0, cut) : null;
		return { data: a.data, slug: articleSlug(a), order: articleOrder(a), Content, preview };
	}),
);
const indexItems = articles.map((a) => ({ order: a.order, title: a.data.title, anchor: a.slug }));
---

<div class="issue-scroll">
	<IssueMasthead
		number={issue.data.number}
		title={issue.data.title}
		date={issue.data.date}
		blurb={issue.data.blurb}
		label={label}
	/>

	{
		articles.map(({ Content, preview, ...a }) => (
			<ArticleBlock
				anchor={a.slug}
				order={a.order}
				deepHref={`${base}/issues/${issue.dir}/${a.slug}/`}
				title={a.data.title}
				dek={a.data.dek}
				kicker={a.data.kicker}
				byline={a.data.byline}
				pubDate={a.data.pubDate}
				updatedDate={a.data.updatedDate}
				heroImage={a.data.heroImage}
				tags={a.data.tags}
				filler={a.data.filler}
			>
				{preview ? (
					<>
						{preview.map((b) =>
							b.type === 'heading' ? (
								<h3>{b.text}</h3>
							) : b.type === 'pull' ? (
								<blockquote>
									<p>{b.text}</p>
								</blockquote>
							) : b.type === 'list' ? (
								<ul>
									{b.items.map((it) => (
										<li>{it}</li>
									))}
								</ul>
							) : b.type === 'para' ? (
								<p>{b.text}</p>
							) : null,
						)}
						{a.data.asciiRoaches && <AsciiRoaches strip />}
						{a.data.cds && <ShelfDisc title={a.data.title} href={`${base}/issues/${issue.dir}/${a.slug}/`} />}
						<p class="read-more">
							<a href={`${base}/issues/${issue.dir}/${a.slug}/`}>[ {a.data.asciiRoaches ? 'See' : 'Read'} more -&gt; ]</a>
						</p>
					</>
				) : (
					<Content />
				)}
				{a.data.chat && (
					<Chat
						me={a.data.byline.split(' ')[0]}
						them={a.data.chatWith ?? 'Them'}
						messages={a.data.chatPreview ? a.data.chat.slice(0, a.data.chatPreview) : a.data.chat}
						moreHref={
							a.data.chatPreview && a.data.chatPreview < a.data.chat.length
								? `${base}/issues/${issue.dir}/${a.slug}/`
								: undefined
						}
					/>
				)}
			</ArticleBlock>
		))
	}

	<p class="issue-endnote">*all words 100% human generated</p>
</div>

<IssueIndex issueTitle={issue.data.title} issueNo={issue.data.number} items={indexItems} />

<style>
	.read-more {
		margin: 2rem 0 0;
	}
	.issue-endnote {
		margin: clamp(3rem, 9vw, 6.5rem) 0 clamp(1.5rem, 4vw, 3rem);
		padding-top: 1.3rem;
		border-top: 2px solid var(--blue);
		font-family: var(--font-hand);
		font-weight: 700;
		font-size: clamp(1.35rem, 3.6vw, 2.1rem);
		line-height: 1;
		color: var(--blue);
	}
</style>
