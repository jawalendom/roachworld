---
// Progressive enhancement wrapper. The slotted HTML is the real article and the
// accessible version; with JS, a toggle re-typesets it onto <canvas> via pretext.
interface Props {
	kicker: string;
	title: string;
	dek: string;
	byline: string;
}
const { kicker, title, dek, byline } = Astro.props;
---

<div
	class="mv"
	data-magazine-view
	data-kicker={kicker}
	data-title={title}
	data-dek={dek}
	data-byline={byline}
>
	<div class="mv-header">
		<slot name="header" />
	</div>

	<div class="mv-toolbar">
		<button type="button" class="mv-toggle" data-mv-toggle aria-pressed="false" hidden>
			Read as magazine
		</button>
		<div class="mv-nav" data-mv-nav hidden>
			<button type="button" data-mv-prev aria-label="Previous page">◄</button>
			<span class="mv-counter" data-mv-counter aria-live="polite">1 / 1</span>
			<button type="button" data-mv-next aria-label="Next page">►</button>
		</div>
	</div>

	<div class="mv-stage" data-mv-stage role="img" aria-label={`${title} — magazine layout`}></div>

	<div class="mv-source entry-body" data-mv-source>
		<slot />
	</div>
</div>

<style>
	.mv {
		margin-top: 2rem;
	}
	.mv-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1rem;
		justify-content: space-between;
		border-top: 2px solid var(--hairline);
		border-bottom: 2px solid var(--hairline);
		padding: 0.5rem 0;
		font-family: var(--font-mono);
	}
	.mv-toggle {
		font: inherit;
		font-size: 0.74rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		background: var(--ink);
		color: var(--paper);
		border: none;
		padding: 0.5em 1em;
		cursor: pointer;
	}
	.mv-toggle[aria-pressed='true'] {
		background: var(--pink);
	}
	.mv-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.8rem;
	}
	.mv-nav button {
		font: inherit;
		background: none;
		border: 2px solid var(--ink);
		width: 2rem;
		height: 2rem;
		cursor: pointer;
		color: var(--ink);
	}
	.mv-nav button:disabled {
		opacity: 0.3;
		cursor: default;
	}
	.mv-stage {
		display: none;
		margin: 1.5rem 0;
	}
	.mv-stage[data-building] {
		opacity: 0.5;
	}
	.mv :global(.mv-canvas) {
		display: block;
		margin: 0 auto;
		max-width: 100%;
		box-shadow: 6px 6px 0 var(--blue);
	}
	.mv.is-magazine .mv-stage {
		display: block;
	}

	/* In magazine mode keep the prose for assistive tech but hide it visually. */
	.mv.is-magazine .mv-source,
	.mv.is-magazine .mv-header {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	/* ── Prose (default reading mode) ─────────────────────────────────────── */
	.entry-body {
		max-width: var(--measure);
		font-size: 1.06rem;
		line-height: 1.68;
	}
	.entry-body :global(p) {
		margin: 0 0 1.2em;
	}
	.entry-body :global(h2),
	.entry-body :global(h3) {
		margin: 2em 0 0.5em;
		color: var(--pink);
		font-size: 1.35rem;
	}
	.entry-body :global(blockquote) {
		margin: 1.8em 0;
		padding-left: 1.1em;
		border-left: 4px solid var(--blue);
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.5rem;
		line-height: 1.25;
		color: var(--blue);
	}
	.entry-body :global(blockquote cite) {
		display: block;
		margin-top: 0.5em;
		font: 0.7rem/1.4 var(--font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink);
		font-style: normal;
	}
	.entry-body :global(figure) {
		margin: 2em 0;
	}
	.entry-body :global(figure.wide) {
		max-width: none;
		width: min(100%, 1100px);
		margin-left: 50%;
		transform: translateX(-50%);
	}
	.entry-body :global(figure img) {
		border: 2px solid var(--ink);
		filter: grayscale(1) contrast(1.15);
	}
	.entry-body :global(figcaption) {
		margin-top: 0.5em;
		font: 0.72rem/1.4 var(--font-mono);
		letter-spacing: 0.04em;
		color: var(--blue);
	}
</style>

<script>
	import { mountMagazineView } from '../lib/pretext/magazineView';
	document
		.querySelectorAll<HTMLElement>('[data-magazine-view]')
		.forEach((el) => mountMagazineView(el));
</script>
