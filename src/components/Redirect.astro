---
// Plain view is gone: its old addresses forward to the standard view.
interface Props {
	to: string;
}
const { to } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>ROACHWORLD</title>
		<meta http-equiv="refresh" content={`0;url=${to}`} />
		<link rel="canonical" href={to} />
		<meta name="robots" content="noindex" />
		<script is:inline define:vars={{ to }}>location.replace(to + location.hash);</script>
	</head>
	<body style="background:#050506"></body>
</html>
