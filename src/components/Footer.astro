---
import { EDITOR, FOUNDED } from '../consts';
const year = new Date().getFullYear();
const span = year === FOUNDED ? `${FOUNDED}` : `${FOUNDED}–${year}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer wrap">
	<span>© {span} {EDITOR}</span>
	<span>Set with <a href="https://github.com/chenglou/pretext">pretext</a> · no browser text layout</span>
	<span>
		Printed in fluorescent pink &amp; blue ·
		<a href={`${base}/rss.xml`}>RSS</a>
	</span>
</footer>
