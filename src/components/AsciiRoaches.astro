---
// Roaches crawling across the screen in ASCII, with a font-size slider that
// zooms the characters in and out. Tap a roach to squash it. `strip` is the
// short band on the issue page: a few roaches crossing, no controls. `full` fills the viewport (editor view);
// otherwise it sits inline in an article as a framed panel.
interface Props {
	full?: boolean;
	strip?: boolean;
	heading?: string;
	backHref?: string;
	backLabel?: string;
}
const { full = false, strip = false, heading, backHref, backLabel } = Astro.props;
---

<div class:list={['ascii', { full, strip }]} data-ascii>
	{full && heading && <p class="ascii-head">{heading}</p>}
	{full && backHref && <a class="ascii-exit" href={backHref}>[ &lt;- {backLabel ?? 'back'} ]</a>}
	{full && (
		<div class="game" data-game data-state="attract">
			<div class="g-attract">
				<p class="g-kick">&gt; arcade</p>
				<h2 class="g-title g-title--prompt" data-g-sub>Squash as many roaches as you can in 30 seconds</h2>
				<button type="button" class="g-play" data-g-play>
					<span aria-hidden="true">▶</span> Press to play
				</button>
				<div class="g-board">
					<p class="g-k">High scores</p>
					<p class="g-cols" aria-hidden="true"><span>#</span><span>Name</span><span>Device</span><span>Score</span></p>
					<ol data-g-board></ol>
					<p class="g-empty" data-g-empty>No scores yet. Be the first.</p>
				</div>
			</div>
			<p class="g-count" data-g-count aria-live="assertive"></p>
			<div class="g-hud" aria-live="off">
				<span>Time <b data-g-time>30.0</b></span>
				<span>Score <b data-g-score>000</b></span>
			</div>
			<form class="g-over" data-g-form>
				<p class="g-title g-title--sm">Time!</p>
				<p class="g-result">You squashed <b data-g-final>0</b></p>
				<div class="g-entry" data-g-entry>
					<label for="g-name">New high score. Enter your name</label>
					<input id="g-name" data-g-name maxlength="12" autocomplete="nickname" spellcheck="false" placeholder="YOUR NAME" />
					<button type="submit" class="g-play">Save score</button>
				</div>
				<button type="button" class="g-play" data-g-skip>See the board</button>
			</form>
		</div>
	)}
	{!strip && !full && (
		<p class="ascii-count" aria-live="polite">
			<span>roaches squashed</span>
			<b data-ascii-count>000</b>
		</p>
	)}
	{!strip && <label class="ascii-panel">
		<span class="ascii-k">/ characters</span>
		<span class="ascii-row">
			<span>font size</span>
			<input type="range" min="6" max="64" step="1" value="40" data-ascii-size aria-label="Character size" />
			<output data-ascii-out>40</output>
		</span>
	</label>}
	<noscript><p class="ascii-k">The roaches need JavaScript.</p></noscript>
</div>

<style>
	.ascii {
		position: relative;
		margin: 2rem 0;
		aspect-ratio: 16 / 10;
		min-height: 360px;
		overflow: hidden;
		background: #050506;
		color: #e6e6e9;
		font-family: var(--font-mono);
		outline: 1px solid rgba(0, 255, 156, 0.35);
	}
	.ascii.strip {
		aspect-ratio: auto;
		height: clamp(150px, 24vw, 220px);
		min-height: 0;
		margin: 1.4rem 0;
	}
	.ascii.full {
		position: fixed;
		inset: 0;
		z-index: 0;
		margin: 0;
		aspect-ratio: auto;
		outline: 0;
	}
	.ascii :global(canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	.ascii-head,
	.ascii-exit,
	.ascii-count,
	.ascii-panel {
		position: absolute;
		z-index: 2;
		margin: 0;
	}
	.ascii-head {
		top: clamp(3.4rem, 9vh, 5rem);
		left: 50%;
		transform: translateX(-50%);
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.4rem, 4vw, 2.6rem);
		white-space: nowrap;
		text-transform: uppercase;
		text-shadow: 0.05em 0 #ff2e4d, -0.05em 0 #13e8ff;
		pointer-events: none;
	}
	.ascii-exit {
		top: clamp(3.4rem, 9vh, 5rem);
		left: clamp(1rem, 3vw, 1.6rem);
		padding: 0.6rem 0.9rem;
		font-size: 0.7rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #00ff9c;
		outline: 1px solid #00ff9c;
		background: #050506;
		text-decoration: none;
	}
	/* squash counter, top right under the nav */
	.ascii-count {
		top: 1rem;
		right: 1rem;
		display: grid;
		justify-items: end;
		gap: 0.15rem;
		padding: 0.55rem 0.8rem;
		background: rgba(14, 14, 16, 0.88);
		border: 1px solid #2a2a2e;
		font-size: 0.6rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: #8a8a90;
		pointer-events: none;
	}
	.ascii-count b {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.8rem;
		line-height: 1;
		letter-spacing: 0.02em;
		color: #ff2e4d;
		text-shadow: -2px 0 #13e8ff;
	}
	.ascii-count.bump b {
		animation: bump 0.25s ease-out;
	}
	@keyframes bump {
		0% { transform: scale(1.35); color: #e6e6e9; }
		100% { transform: scale(1); }
	}
	.full .ascii-count {
		top: clamp(3.4rem, 9vh, 5rem);
		right: clamp(1rem, 3vw, 1.6rem);
	}
	.full :global(canvas) {
		touch-action: none;
	}
	@media (max-width: 640px) {
		.ascii-head {
			top: 8.2rem;
		}
		/* phones: a slim tally centred under the title, clear of the back button */
		.full .ascii-count {
			top: calc(8.2rem + clamp(1.9rem, 6vw, 2.4rem));
			right: auto;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			align-items: baseline;
			gap: 0.6rem;
			padding: 0.35rem 0.7rem;
			white-space: nowrap;
		}
		.full .ascii-count b {
			font-size: 1.2rem;
		}
	}
	/* ── the squash game: the arcade layer ─────────────────────────── */
	.game {
		position: absolute;
		inset: 0;
		z-index: 3;
		pointer-events: none;
		font-family: var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}
	.game > * {
		display: none;
	}
	.game[data-state='attract'] .g-attract,
	.game[data-state='count'] .g-count,
	.game[data-state='play'] .g-hud,
	.game[data-state='over'] .g-over {
		display: grid;
	}
	.game[data-state='play'] .g-count {
		display: grid; /* the GO! lingers a beat */
	}
	/* attract + game over: a dim card over the crawling roaches */
	.g-attract,
	.g-over {
		position: absolute;
		left: 50%;
		top: 50%;
		translate: -50% -50%;
		width: min(26rem, calc(100% - 2rem));
		max-height: calc(100% - 9rem);
		overflow: auto;
		justify-items: center;
		gap: 0.9rem;
		padding: 1.6rem 1.4rem 1.4rem;
		background: rgba(5, 5, 6, 0.9);
		border: 1px solid rgba(0, 255, 156, 0.55);
		box-shadow: 0 0 0 4px rgba(5, 5, 6, 0.6), 0 24px 60px rgba(0, 0, 0, 0.6);
		text-align: center;
		pointer-events: auto;
	}
	.g-kick {
		margin: 0;
		font-size: 0.62rem;
		color: #00ff9c;
	}
	.g-title {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.9rem, 7vw, 2.8rem);
		line-height: 0.95;
		letter-spacing: 0.01em;
		color: #e6e6e9;
		text-shadow: 0.05em 0 #ff2e4d, -0.05em 0 #13e8ff;
	}
	.g-title--prompt {
		font-size: clamp(1.3rem, 5vw, 1.9rem);
		line-height: 1.05;
	}
	.g-title--sm {
		font-size: clamp(1.6rem, 6vw, 2.2rem);
	}
	.g-sub,
	.g-result {
		margin: 0;
		font-size: 0.68rem;
		line-height: 1.6;
		color: #8a8a90;
		text-transform: none;
		letter-spacing: 0.06em;
	}
	.g-result b {
		display: block;
		margin-top: 0.3rem;
		font-family: var(--font-display);
		font-size: 3rem;
		line-height: 1;
		color: #ff2e4d;
		text-shadow: -0.04em 0 #13e8ff;
	}
	.g-play {
		min-height: 48px;
		padding: 0.8rem 1.4rem;
		border: 0;
		background: #00ff9c;
		color: #050506;
		cursor: pointer;
		font: inherit;
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		animation: g-blink 1.1s steps(1) infinite;
	}
	.g-play:hover,
	.g-play:focus-visible {
		outline: 2px solid #e6e6e9;
		outline-offset: 3px;
		animation: none;
	}
	@keyframes g-blink {
		50% {
			background: #e6e6e9;
		}
	}
	[data-g-skip] {
		background: none;
		color: #8a8a90;
		min-height: 40px;
		font-size: 0.66rem;
		animation: none;
	}
	.g-board {
		width: 100%;
		margin-top: 0.4rem;
		border-top: 1px solid rgba(230, 230, 233, 0.12);
		padding-top: 0.9rem;
	}
	.g-k {
		margin: 0 0 0.5rem;
		font-size: 0.6rem;
		color: #ff2e4d;
	}
	.g-cols {
		display: grid;
		grid-template-columns: 2.2rem 1fr 4.4rem 2.6rem;
		gap: 0.6rem;
		margin: 0 0 0.2rem;
		padding: 0 0.4rem;
		font-size: 0.52rem;
		color: #5f6068;
		text-align: left;
	}
	.g-cols span:last-child {
		text-align: right;
	}
	.g-board:has([data-g-empty]:not([hidden])) .g-cols {
		display: none;
	}
	.g-board ol {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.72rem;
	}
	.g-board :global(li) {
		display: grid;
		grid-template-columns: 2.2rem 1fr 4.4rem 2.6rem;
		gap: 0.6rem;
		padding: 0.32rem 0.4rem;
		color: #e6e6e9;
		text-align: left;
	}
	.g-board :global(li span:first-child),
	.g-board :global(li span:last-child) {
		color: #8a8a90;
	}
	.g-board :global(li span:last-child) {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}
	/* device tag */
	.g-board :global(li span:nth-child(3)) {
		font-size: 0.56rem;
		letter-spacing: 0.12em;
		color: #13e8ff;
		align-self: center;
	}
	.g-board :global(li[data-you]) {
		background: #00ff9c;
		color: #050506;
		animation: g-blink 0.9s steps(1) infinite;
	}
	.g-board :global(li[data-you] span) {
		color: #050506 !important;
	}
	.g-empty {
		margin: 0;
		font-size: 0.66rem;
		color: #5f6068;
		text-transform: none;
		letter-spacing: 0.06em;
	}
	.g-entry {
		display: grid;
		gap: 0.6rem;
		width: 100%;
		justify-items: center;
	}
	.g-entry label {
		font-size: 0.62rem;
		color: #00ff9c;
	}
	.g-entry input {
		width: 100%;
		max-width: 16rem;
		padding: 0.7rem 0.8rem;
		border: 1px solid #00ff9c;
		background: #050506;
		color: #e6e6e9;
		font: inherit;
		font-size: 1rem;
		letter-spacing: 0.24em;
		text-align: center;
		text-transform: uppercase;
	}
	.g-entry input:focus {
		outline: 2px solid #e6e6e9;
		outline-offset: 2px;
	}
	/* 3 · 2 · 1 · GO */
	.g-count {
		position: absolute;
		inset: 0;
		place-items: center;
		margin: 0;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(6rem, 30vw, 14rem);
		line-height: 1;
		color: #e6e6e9;
		text-shadow: 0.05em 0 #ff2e4d, -0.05em 0 #13e8ff;
		pointer-events: none;
	}
	.g-count.tick {
		animation: g-tick 0.9s cubic-bezier(0.2, 1.4, 0.4, 1) both;
	}
	@keyframes g-tick {
		0% { scale: 1.8; opacity: 0; }
		25% { scale: 1; opacity: 1; }
		85% { opacity: 1; }
		100% { scale: 0.9; opacity: 0; }
	}
	/* the round's readout */
	.g-hud {
		position: absolute;
		left: 50%;
		top: clamp(5.4rem, 14vh, 7.5rem);
		translate: -50% 0;
		grid-auto-flow: column;
		gap: 1.6rem;
		padding: 0.6rem 1.1rem;
		background: rgba(5, 5, 6, 0.85);
		border: 1px solid rgba(0, 255, 156, 0.5);
		font-size: 0.66rem;
		color: #8a8a90;
		white-space: nowrap;
	}
	.g-hud b {
		margin-left: 0.5rem;
		font-family: var(--font-display);
		font-size: 1.6rem;
		color: #e6e6e9;
		font-variant-numeric: tabular-nums;
	}
	.g-hud [data-g-score] {
		color: #ff2e4d;
	}
	.g-hud.bump [data-g-score] {
		display: inline-block;
		animation: bump 0.2s ease-out;
	}
	.g-hud[data-low] [data-g-time] {
		color: #ff2e4d;
		animation: g-blink-t 0.5s steps(1) infinite;
	}
	@keyframes g-blink-t {
		50% { opacity: 0.3; }
	}
	/* while a round runs, the title steps aside (the size control stays) */
	.full:is([data-game-state='count'], [data-game-state='play']) .ascii-head {
		visibility: hidden;
	}
	@media (max-width: 640px) {
		.g-hud {
			top: auto;
			bottom: 5.2rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.g-play,
		.g-count.tick,
		.g-board :global(li[data-you]) {
			animation: none;
		}
	}
	/* the control: a small panel like ascii-magic's style node */
	.ascii-panel {
		right: 1rem;
		bottom: 1rem;
		display: grid;
		gap: 0.55rem;
		padding: 0.8rem 1rem;
		background: rgba(14, 14, 16, 0.92);
		border: 1px solid #2a2a2e;
		font-size: 0.68rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}
	.full .ascii-panel {
		left: 50%;
		right: auto;
		bottom: clamp(4.6rem, 11vh, 6rem);
		transform: translateX(-50%);
	}
	.ascii-k {
		color: #8a8a90;
	}
	.ascii-row {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		color: #e6e6e9;
		white-space: nowrap;
	}
	.ascii-row output {
		min-width: 2ch;
		text-align: right;
		color: #00ff9c;
	}
	input[type='range'] {
		appearance: none;
		width: clamp(8rem, 22vw, 13rem);
		height: 2px;
		background: #3a3a40;
		cursor: pointer;
	}
	input[type='range']::-webkit-slider-thumb {
		appearance: none;
		width: 14px;
		height: 14px;
		background: #e6e6e9;
		border: 0;
	}
	input[type='range']::-moz-range-thumb {
		width: 14px;
		height: 14px;
		background: #e6e6e9;
		border: 0;
		border-radius: 0;
	}
	input[type='range']:focus-visible {
		outline: 1px solid #00ff9c;
		outline-offset: 6px;
	}
</style>

<script>
	import { mountAsciiRoaches, type AsciiRoaches } from '../lib/ascii/roaches';
	import { getScores, qualifies, submitScore, type Score, type Device } from '../lib/ascii/leaderboard';

	const ROUND = 30; // seconds

	// The squash game: attract screen + high scores → 3·2·1·GO → 30s round → name
	// entry if it made the board → back to the board with your row lit
	function runGame(
		game: HTMLElement,
		art: AsciiRoaches,
		ctl: { onSquash(fn: ((n: number, pointer: string) => void) | null): void },
	) {
		const host = game.closest<HTMLElement>('[data-ascii]')!;
		const q = <T extends Element>(s: string) => game.querySelector<T>(s)!;
		const playBtn = q<HTMLButtonElement>('[data-g-play]');
		const boardEl = q<HTMLOListElement>('[data-g-board]');
		const emptyEl = q<HTMLElement>('[data-g-empty]');
		const countEl = q<HTMLElement>('[data-g-count]');
		const hud = q<HTMLElement>('.g-hud');
		const timeEl = q<HTMLElement>('[data-g-time]');
		const scoreEl = q<HTMLElement>('[data-g-score]');
		const form = q<HTMLFormElement>('[data-g-form]');
		const finalEl = q<HTMLElement>('[data-g-final]');
		const entry = q<HTMLElement>('[data-g-entry]');
		const nameIn = q<HTMLInputElement>('[data-g-name]');
		const skip = q<HTMLButtonElement>('[data-g-skip]');
		const sub = q<HTMLElement>('[data-g-sub]');
		let score = 0, timer = 0;
		// how the round was played: counted per squash, so a laptop with a touch
		// screen is labelled by what was actually used
		let taps = 0, clicks = 0;
		const device = (): Device =>
			taps || clicks ? (taps >= clicks ? 'mobile' : 'desktop') : matchMedia('(pointer: coarse)').matches ? 'mobile' : 'desktop';

		const state = (s: 'attract' | 'count' | 'play' | 'over') => {
			game.dataset.state = s;
			host.dataset.gameState = s;
		};
		const pad = (n: number) => String(n).padStart(3, '0');
		const drawBoard = (list: Score[], you = -1) => {
			boardEl.replaceChildren(
				...list.map((s, i) => {
					const li = document.createElement('li');
					if (i === you) li.dataset.you = '';
					for (const t of [String(i + 1).padStart(2, '0'), s.name, s.device ? (s.device === 'mobile' ? 'MOBILE' : 'DESKTOP') : '—', pad(s.score)]) {
						const sp = document.createElement('span');
						sp.textContent = t;
						li.append(sp);
					}
					return li;
				}),
			);
			emptyEl.hidden = list.length > 0;
		};

		const attract = async (you = -1, list?: Score[]) => {
			art.setArmed(false);
			drawBoard(list ?? (await getScores()), you);
			playBtn.lastChild!.textContent = you >= 0 || score > 0 ? ' Play again' : ' Press to play';
			state('attract');
		};

		const start = () => {
			art.reset();
			art.setArmed(false);
			score = 0;
			taps = clicks = 0;
			scoreEl.textContent = pad(0);
			timeEl.textContent = ROUND.toFixed(1);
			hud.removeAttribute('data-low');
			state('count');
			const steps = ['3', '2', '1', 'GO!'];
			steps.forEach((t, i) =>
				window.setTimeout(() => {
					countEl.textContent = t;
					countEl.classList.remove('tick');
					void countEl.offsetWidth;
					countEl.classList.add('tick');
					if (t === 'GO!') play();
				}, i * 800),
			);
		};

		const play = () => {
			state('play');
			art.setArmed(true);
			ctl.onSquash((_, pointer) => {
				pointer === 'touch' ? taps++ : clicks++;
				score++;
				scoreEl.textContent = pad(score);
				hud.classList.remove('bump');
				void hud.offsetWidth;
				hud.classList.add('bump');
			});
			const t0 = performance.now();
			const tick = (now: number) => {
				const left = Math.max(0, ROUND - (now - t0) / 1000);
				timeEl.textContent = left.toFixed(1);
				hud.toggleAttribute('data-low', left <= 5);
				if (left > 0) timer = requestAnimationFrame(tick);
				else over();
			};
			timer = requestAnimationFrame(tick);
		};

		const over = async () => {
			cancelAnimationFrame(timer);
			art.setArmed(false);
			ctl.onSquash(null);
			countEl.textContent = '';
			finalEl.textContent = String(score);
			const made = await qualifies(score);
			entry.hidden = !made;
			skip.textContent = made ? 'Skip' : 'See the board';
			nameIn.value = '';
			state('over');
			if (made) nameIn.focus({ preventScroll: true });
			else skip.focus({ preventScroll: true });
		};

		playBtn.addEventListener('click', start);
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const { board, place } = await submitScore(nameIn.value, score, device());
			attract(place, board);
		});
		skip.addEventListener('click', () => attract());
		sub.textContent = `Squash as many roaches as you can in ${ROUND} seconds`;
		attract();
	}
	for (const host of document.querySelectorAll<HTMLElement>('[data-ascii]')) {
		if (host.classList.contains('strip')) {
			mountAsciiRoaches(host, { size: 11, strip: true });
			continue;
		}
		const range = host.querySelector<HTMLInputElement>('[data-ascii-size]')!;
		const out = host.querySelector<HTMLOutputElement>('[data-ascii-out]')!;
		const count = host.querySelector<HTMLElement>('[data-ascii-count]');
		const game = host.querySelector<HTMLElement>('[data-game]');
		let onRoundSquash: ((n: number, pointer: string) => void) | null = null;
		const onSquash = (n: number, pointer: string) => {
			onRoundSquash?.(n, pointer);
			if (!count) return;
			count.textContent = String(n).padStart(3, '0');
			const box = count.parentElement!;
			box.classList.remove('bump');
			void box.offsetWidth;
			box.classList.add('bump');
		};
		mountAsciiRoaches(host, { size: Number(range.value), onSquash }).then((art) => {
			const set = (v: number) => {
				range.value = String(Math.max(Number(range.min), Math.min(Number(range.max), Math.round(v))));
				out.value = range.value;
				art.setSize(Number(range.value));
			};
			range.addEventListener('input', () => set(Number(range.value)));
			// full screen: scrolling zooms the characters too (the page itself doesn't scroll)
			if (host.classList.contains('full')) {
				let acc = Number(range.value);
				host.addEventListener(
					'wheel',
					(e) => {
						if ((e.target as HTMLElement).closest('.ascii-panel, .g-attract, .g-over')) return;
						e.preventDefault();
						acc = Math.max(6, Math.min(64, acc - e.deltaY * 0.04));
						if (Math.round(acc) !== Number(range.value)) set(acc);
					},
					{ passive: false },
				);
				range.addEventListener('input', () => (acc = Number(range.value)));
				// phones: dragging up and down the screen moves the size slider
				let lastY: number | null = null;
				host.addEventListener('touchstart', (e) => {
					if ((e.target as HTMLElement).closest('.ascii-panel, a, .g-attract, .g-over')) return;
					lastY = e.touches[0].clientY;
				}, { passive: true });
				host.addEventListener('touchmove', (e) => {
					if (lastY == null) return;
					e.preventDefault();
					const y = e.touches[0].clientY;
					// drag up = zoom in (bigger), down = zoom out
					acc = Math.max(6, Math.min(64, acc + (lastY - y) * 0.08));
					lastY = y;
					if (Math.round(acc) !== Number(range.value)) set(acc);
				}, { passive: false });
				host.addEventListener('touchend', () => (lastY = null));
			}
			if (game) runGame(game, art, { onSquash: (fn) => (onRoundSquash = fn) });
		});
	}
</script>
