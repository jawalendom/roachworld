---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import FallbackImage from '../assets/cover-fallback.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const withBase = (p: string) =>
	`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${p.replace(/^\//, '')}`;
const { title, description, image = FallbackImage } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(withBase('rss.xml'), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-display" preload />
<Font cssVariable="--font-body" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-hand" />

<link rel="canonical" href={canonicalURL} />

<title>{pageTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content="article" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta name="twitter:card" content="summary_large_image" />
