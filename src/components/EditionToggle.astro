---
// The view switch, bottom-left on every page: Standard view (the zine as
// designed) / Editor's view (the same pages digicrushed — pixelated,
// posterised, torn, smeared, buried in roaches — barely usable on purpose).
// The choice is kept per browser. The switch itself sits in the browser's top
// layer, so the crush never touches it: there's always a clean way back.
---

<nav class="edt" aria-label="View" popover="manual" data-view-toggle>
	<button type="button" data-view="standard">Standard view</button>
	<span class="edt-sep">/</span>
	<button type="button" data-view="editor">Editor's view</button>
</nav>

<style>
	.edt {
		position: fixed;
		inset: auto auto clamp(0.8rem, 3vw, 1.5rem) clamp(0.8rem, 3vw, 1.5rem);
		margin: 0;
		z-index: 60;
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		background: #050506;
		color: #5f6068;
		border: 1px solid #00ff9c;
		padding: 0.55em 0.8em;
		overflow: visible;
		cursor: auto;
	}
	.edt button {
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;
		font: inherit;
		letter-spacing: inherit;
		text-transform: inherit;
		color: inherit;
	}
	.edt button:hover {
		color: #e6e6e9;
	}
	.edt button[aria-pressed='true'] {
		color: #00ff9c;
	}
	.edt button[data-view='editor'][aria-pressed='true'] {
		color: #ff2e4d;
		text-shadow: 0.08em 0 #13e8ff;
	}
	.edt-sep {
		opacity: 0.5;
	}
</style>

<script>
	const el = document.querySelector<HTMLElement>('[data-view-toggle]');
	if (el) {
		// top layer: drawn above (and outside) anything the crush filters
		try {
			el.showPopover();
		} catch {}
		const btns = el.querySelectorAll<HTMLButtonElement>('[data-view]');
		const sync = () => {
			const v = document.documentElement.hasAttribute('data-crush') ? 'editor' : 'standard';
			btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
		};
		sync();
		btns.forEach((b) =>
			b.addEventListener('click', () => {
				window.dispatchEvent(new CustomEvent('roachworld:view', { detail: b.dataset.view }));
				sync();
			}),
		);
		window.addEventListener('roachworld:view-changed', sync);
	}
</script>
